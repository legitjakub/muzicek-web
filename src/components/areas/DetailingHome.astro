---
import MicrositeHeader from '../MicrositeHeader.astro'
import SiteFooter from '../SiteFooter.astro'
import ArrowIcon from '../ArrowIcon.astro'
const links=[{label:'PPF',href:'/detailing/ppf/'},{label:'Wrap',href:'/detailing/wrap-folie/'},{label:'Tónování',href:'/detailing/tonovani-skel/'},{label:'Mytí',href:'/detailing/cisteni-a-myti/'},{label:'Lak',href:'/detailing/lesteni-a-ochrana-laku/'},{label:'Renovace',href:'/detailing/individualni-renovace/'},{label:'Kontakt',href:'#kontakt'}]
const paths=[
  {intent:'Ochránit',title:'PPF ochranné fólie',text:'Transparentní ochrana namáhaných částí i celého vozu.',href:'/detailing/ppf/',image:'/media/ppf-work.jpg'},
  {intent:'Změnit vzhled',title:'Wrap a tónování',text:'Barevná fólie, promyšlené akcenty a tónování skel.',href:'/detailing/wrap-folie/',image:'/media/defender-v8.jpg'},
  {intent:'Obnovit',title:'Lak a individuální renovace',text:'Korekce laku i citlivá obnova historických materiálů.',href:'/detailing/lesteni-a-ochrana-laku/',image:'/media/maserati-merak.jpg'},
  {intent:'Udržovat',title:'Ruční mytí a čištění',text:'Pravidelná péče, která respektuje použitou ochranu.',href:'/detailing/cisteni-a-myti/',image:'/media/alfa-4c.jpg'},
]
---
<MicrositeHeader section="detailing" tone="light" links={links}/>
<main class="detailing" id="main-content">
  <section class="detail-hero">
    <div class="detail-hero__copy">
      <p class="kicker">Profesionální detailing od roku 2014</p>
      <h1>Ochrana začíná přípravou.</h1>
      <p>PPF, wrap, lak, interiér i historické materiály. Nejdřív zkontrolujeme skutečný stav a teprve potom navrhneme rozsah práce.</p>
      <a class="text-link" href="#sluzby">Vybrat službu</a>
    </div>
    <figure class="detail-hero__film">
      <video autoplay muted loop playsinline preload="metadata" poster="/media/ppf-film.jpg" aria-label="Aplikace ochranné fólie v dílně Mužíček">
        <source src="/media/muzicek-detailing-process.mp4" type="video/mp4" />
      </video>
      <figcaption><span>PPF</span><span>Příprava a aplikace v našem studiu</span></figcaption>
    </figure>
  </section>

  <section class="detail-statement">
    <div class="detail-statement__copy">
      <p class="kicker">Nejdřív povrch přečíst</p>
      <h2>Stejný lesk neznamená stejný postup.</h2>
      <p>Nový vůz, každodenní auto a veterán potřebují jinou přípravu, jinou technologii i jinou následnou péči. Rozhodujeme podle materiálu a skutečného stavu, ne podle univerzálního balíčku.</p>
    </div>
    <figure><img src="/media/alfa-4c-detail.jpg" alt="Kontrola laku Alfa Romeo 4C v bočním světle" loading="lazy"/><figcaption>Kontrola povrchu v bočním světle</figcaption></figure>
  </section>

  <section class="service-paths page-width" id="sluzby">
    <header><p class="kicker">Co chcete s vozem řešit?</p><h2>Čtyři důvody,<br/>proč k nám přijet.</h2></header>
    <div class="service-paths__list">
      {paths.map((path)=><a href={path.href}>
        <span class="service-paths__intent">{path.intent}</span>
        <span class="service-paths__title">{path.title}<small>{path.text}</small></span>
        <img src={path.image} alt="" loading="lazy"/>
        <span class="service-paths__arrow"><ArrowIcon/></span>
      </a>)}
    </div>
    <div class="service-paths__secondary"><a href="/detailing/tonovani-skel/">Tónování skel <ArrowIcon /></a><a href="/detailing/individualni-renovace/">Individuální renovace <ArrowIcon /></a></div>
  </section>

  <section class="care-standard">
    <div class="care-standard__image"><img src="/media/hala.jpg" alt="Zabezpečené zázemí studia Mužíček" loading="lazy"/></div>
    <div class="care-standard__copy">
      <p class="kicker">Vůz u nás</p>
      <h2>Máme pod kontrolou práci i to, co je kolem ní.</h2>
      <ol>
        <li><div><h3>Převzetí</h3><p>Stav vozu zdokumentujeme a společně vyplníme předávací protokol.</p></div></li>
        <li><div><h3>Bezpečné zázemí</h3><p>Studio je po pracovní době zabezpečené kamerovým systémem a máme sjednané pojištění odpovědnosti.</p></div></li>
        <li><div><h3>Péče během zakázky</h3><p>Podle potřeby vůz připojíme k udržovací nabíječce a po dokončení jej chráníme autoplachtou do předání.</p></div></li>
      </ol>
    </div>
  </section>

  <section class="gallery page-width">
    <div class="gallery__copy"><p class="kicker">Skutečné realizace</p><h2>Práci ukazujeme zblízka.</h2><p>Bez renderů a ilustračních stock fotografií. Vozy, povrchy a proces, který proběhl u nás.</p></div>
    <div class="gallery__grid"><figure><img src="/media/bmw-m3-touring.jpg" alt="BMW M3 Touring" loading="lazy"/><figcaption>BMW M3 Touring</figcaption></figure><figure><img src="/media/amg-yellow.jpg" alt="Mercedes-AMG GT" loading="lazy"/><figcaption>Mercedes-AMG GT</figcaption></figure><figure><img src="/media/impreza-prodrive.jpg" alt="Subaru Impreza Prodrive" loading="lazy"/><figcaption>Subaru Impreza Prodrive</figcaption></figure></div>
  </section>

  <section class="detail-contact" id="kontakt"><div class="page-width"><p class="kicker">Konzultace vozu</p><h2>Přijeďte. Povrch projdeme společně.</h2><p>Podzimní 10, Jablonec nad Nisou. Pondělí až pátek, 8:00–17:00.</p><div><a class="button button--red" href="mailto:info@muzicek.com?subject=Poptávka%20Muzicek%20Detailing">Domluvit konzultaci</a><a class="text-link" href="tel:+420775911005">+420 775 911 005</a></div></div></section>
</main>
<SiteFooter section="Detailing"/>

<style>
  .detailing{background:#e9e6df}.detail-hero{height:clamp(720px,88svh,880px);display:grid;grid-template-columns:minmax(470px,1.08fr) minmax(390px,.92fr);padding-top:92px}.detail-hero__copy{display:flex;flex-direction:column;justify-content:flex-end;padding:100px clamp(30px,5.5vw,88px) 58px}.detail-hero h1{max-width:690px;margin:22px 0 26px;font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(54px,6vw,90px);font-weight:400;line-height:.9;letter-spacing:-.05em;text-wrap:balance}.detail-hero__copy>p:not(.kicker){max-width:560px;margin:0 0 30px;font-size:16px;line-height:1.68}.detail-hero__copy .text-link{align-self:flex-start}.detail-hero__film{position:relative;margin:0;min-height:0;overflow:hidden;background:#111}.detail-hero__film video{width:100%;height:100%;object-fit:cover;object-position:center 45%;filter:saturate(.84) contrast(1.03)}.detail-hero__film::after{content:'';position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.4),transparent 48%);pointer-events:none}.detail-hero__film figcaption{position:absolute;z-index:2;left:24px;right:24px;bottom:22px;display:flex;justify-content:space-between;gap:20px;color:#fff;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.detail-hero__film figcaption span:first-child{color:#fff}.detail-hero__film figcaption span:first-child::before{content:'';display:inline-block;width:26px;height:2px;margin:0 10px 3px 0;background:var(--red)}
  .detail-statement{display:grid;grid-template-columns:.76fr 1.24fr;min-height:680px;background:#0b0b0b;color:#fff}.detail-statement__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(52px,6vw,96px)}.detail-statement h2{max-width:620px;margin:22px 0 27px;font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(48px,5.2vw,76px);font-weight:400;line-height:.93;letter-spacing:-.045em}.detail-statement__copy>p:last-child{max-width:540px;color:#aaa;font-size:15px;line-height:1.72}.detail-statement figure{position:relative;margin:0;overflow:hidden}.detail-statement figure img{width:100%;height:100%;object-fit:cover;object-position:center 57%}.detail-statement figcaption{position:absolute;right:18px;bottom:17px;padding:9px 11px;background:#ece9e2;color:#111;font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .service-paths{display:grid;grid-template-columns:.52fr 1.48fr;gap:clamp(55px,8vw,125px);padding-block:110px}.service-paths header{position:sticky;top:120px;align-self:start}.service-paths h2{margin:20px 0 0;font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(45px,5vw,72px);font-weight:400;line-height:.94;letter-spacing:-.045em}.service-paths__list{border-top:1px solid #999}.service-paths__list>a{display:grid;grid-template-columns:minmax(110px,.4fr) minmax(250px,1fr) 136px 34px;align-items:center;gap:clamp(16px,2.2vw,32px);min-height:142px;padding:13px 0;border-bottom:1px solid #999}.service-paths__intent{align-self:start;padding-top:12px;color:#666;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.service-paths__title{font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(26px,2.8vw,40px);line-height:1}.service-paths__title small{display:block;max-width:390px;margin-top:11px;color:#555;font-family:'Avenir Next',Avenir,sans-serif;font-size:12px;line-height:1.55}.service-paths__list img{width:100%;height:96px;object-fit:cover;object-position:center;filter:saturate(.78);transition:filter .3s,transform .45s}.service-paths__list>a:nth-child(2) img{object-position:center 62%}.service-paths__list>a:nth-child(3) img{object-position:center 58%}.service-paths__arrow{display:grid;place-items:center;color:var(--red);transition:transform .25s}.service-paths__list>a:hover img{filter:saturate(1);transform:scale(.97)}.service-paths__list>a:hover .service-paths__arrow{transform:translateX(4px)}.service-paths__secondary{grid-column:2;display:flex;justify-content:flex-end;gap:36px}.service-paths__secondary a{display:flex;align-items:center;gap:10px;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.service-paths__secondary :global(svg){color:var(--red)}
  .care-standard{display:grid;grid-template-columns:1.08fr .92fr;min-height:650px;background:#d1ccc1}.care-standard__image{overflow:hidden}.care-standard__image img{width:100%;height:100%;object-fit:cover;object-position:center 58%}.care-standard__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(48px,5.5vw,86px)}.care-standard h2{max-width:620px;margin:20px 0 34px;font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(42px,4.8vw,68px);font-weight:400;line-height:.94;letter-spacing:-.045em}.care-standard ol{margin:0;padding:0;list-style:none;border-top:1px solid #999}.care-standard li{padding:19px 0;border-bottom:1px solid #999}.care-standard h3{margin:0 0 7px;font-size:16px}.care-standard li p{max-width:520px;margin:0;color:#52514e;font-size:13px;line-height:1.58}
  .gallery{display:grid;grid-template-columns:.52fr 1.48fr;gap:clamp(50px,8vw,115px);padding-block:110px}.gallery h2{margin:20px 0 22px;font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(45px,5vw,72px);font-weight:400;line-height:.94;letter-spacing:-.045em}.gallery__copy>p:last-child{max-width:390px;line-height:1.7}.gallery__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.gallery figure{margin:0}.gallery figure:nth-child(2){margin-top:30px}.gallery figure:nth-child(3){margin-top:60px}.gallery img{width:100%;aspect-ratio:4/5;object-fit:cover}.gallery figure:nth-child(1) img{object-position:center 54%}.gallery figure:nth-child(2) img{object-position:center 60%}.gallery figure:nth-child(3) img{object-position:center 55%}.gallery figcaption{margin-top:10px;font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
  .detail-contact{padding:100px 0;background:#0b0b0b;color:#fff}.detail-contact h2{max-width:1000px;margin:20px 0 22px;font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(50px,6vw,86px);font-weight:400;line-height:.92;letter-spacing:-.045em}.detail-contact p:not(.kicker){color:#aaa}.detail-contact>div>div{display:flex;align-items:center;gap:28px;margin-top:34px}
  @media(max-width:980px){.detail-hero{height:auto;grid-template-columns:1fr;padding-top:76px}.detail-hero__copy{min-height:540px}.detail-hero__film{min-height:72svh;max-height:820px}.detail-statement,.service-paths,.care-standard,.gallery{grid-template-columns:1fr}.detail-statement figure{min-height:62vw}.service-paths header{position:static}.service-paths__secondary{grid-column:auto}.care-standard__image{min-height:58vw}.gallery__grid{max-width:900px}}
  @media(max-width:650px){.detail-hero__copy{min-height:510px;padding:125px 18px 42px}.detail-hero h1{font-size:47px}.detail-hero__film{min-height:78svh}.detail-statement__copy,.care-standard__copy{padding:72px 18px}.detail-statement figure{min-height:88vw}.service-paths{padding-block:78px}.service-paths__list>a{grid-template-columns:1fr 30px;min-height:112px}.service-paths__intent{display:none}.service-paths__title{font-size:28px}.service-paths__list img{display:none}.service-paths__secondary{align-items:flex-start;flex-direction:column;gap:18px}.care-standard__image{min-height:78vw}.gallery{padding-block:78px}.gallery__grid{grid-template-columns:repeat(3,76vw);overflow-x:auto}.gallery figure:nth-child(n){margin-top:0}.detail-contact{padding-block:78px}.detail-contact h2{font-size:48px}.detail-contact>div>div{align-items:flex-start;flex-direction:column}}
</style>
