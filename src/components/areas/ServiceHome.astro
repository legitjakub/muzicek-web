---
import MicrositeHeader from '../MicrositeHeader.astro'
import SiteFooter from '../SiteFooter.astro'
import ArrowIcon from '../ArrowIcon.astro'
const links=[{label:'Servis & performance',href:'/servis/servis-a-performance/'},{label:'Suchý led',href:'/servis/suchy-led/'},{label:'Ochrana podvozku',href:'/servis/antikorozni-ochrana-podvozku/'},{label:'Realizace',href:'#realizace'},{label:'Zázemí',href:'#zazemi'},{label:'Kontakt',href:'#kontakt'}]
---
<MicrositeHeader section="servis" tone="dark" links={links}/>
<main class="service-site" id="main-content">
  <section class="workshop-hero"><img src="/media/service-cayman.jpg" alt="Porsche Cayman v servisu Mužíček" data-parallax/><div class="workshop-hero__shade"></div><div class="workshop-hero__copy"><p class="kicker">Servis a performance</p><h1>Nejdřív příčina.<br/>Potom řešení.</h1><p>Servisujeme vozy Porsche, BMW, Mercedes-Benz, Audi, Volkswagen a další. Podle postupů výrobců, s originálními nebo ověřenými díly a s možností projít práci přímo s mechanikem.</p></div><a class="workshop-hero__cta" href="#sluzby"><span>Co řešíme</span><ArrowIcon direction="down" /></a></section>
  <section class="service-facts" aria-label="Standard práce v servisu"><div><strong>Diagnostika před výměnou dílů</strong></div><div><strong>Potvrzený rozsah a rozpočet</strong></div><div><strong>Originální nebo ověřené díly</strong></div><div><strong>Společná kontrola při předání</strong></div></section>
  <section class="diagnosis page-width" id="sluzby"><aside><p class="kicker">Diagnostika před domněnkami</p><p>Nejdřív zjistíme skutečný stav. Pak teprve navrhneme práci, termín a rozpočet.</p></aside><div class="service-ledger"><a href="/servis/servis-a-performance/"><span>Mechanika</span><strong>Servis & performance</strong><small>Běžná údržba, složité opravy i individuální úpravy.</small></a><a href="/servis/suchy-led/"><span>Renovace</span><strong>Čištění suchým ledem</strong><small>Neabrazivní čištění podvozku a motorového prostoru.</small></a><a href="/servis/antikorozni-ochrana-podvozku/"><span>Prevence</span><strong>Ochrana podvozku</strong><small>Důkladná příprava, ošetření koroze a konzervace dutin.</small></a></div></section>
  <section class="ice-story" id="realizace"><div class="ice-story__copy"><p class="kicker">Suchý led</p><h2>Nečistoty pryč.<br/>Materiál zůstává.</h2><p>Pelety suchého ledu při nárazu sublimují. Bez vody, abraziva a zbytkového odpadu odhalí skutečný stav podvozku.</p><a class="text-link" href="/servis/suchy-led/">Jak technologie funguje</a></div><div class="ice-story__mosaic"><img src="/media/dry-ice-3.jpg" alt="Čištění suchým ledem" loading="lazy"/><img src="/media/dry-ice-1.jpg" alt="Detail podvozku při renovaci" loading="lazy"/><img src="/media/dry-ice-4.jpg" alt="Vyčištěný podvozek vozu" loading="lazy"/></div></section>
  <section class="workshop" id="zazemi"><div class="workshop__image"><img src="/media/hala.jpg" alt="Zázemí Mužíček v Jablonci nad Nisou" loading="lazy" data-parallax/></div><div class="workshop__copy"><p class="kicker">Zázemí</p><h2>Vůz máte po celou dobu pod kontrolou.</h2><dl><div><dt>Příjem</dt><dd>Vstupní kontrola a dokumentace</dd></div><div><dt>Práce</dt><dd>Potvrzený rozsah a průběžná domluva</dd></div><div><dt>Předání</dt><dd>Kontrola hotové práce společně s vámi</dd></div></dl></div></section>
  <section class="service-contact" id="kontakt"><div class="page-width"><p class="kicker">Objednat servis</p><h2>Popište vůz a co potřebujete vyřešit.</h2><div><a class="button button--red" href="mailto:info@muzicek.com?subject=Poptávka%20Muzicek%20Servis">Poslat poptávku</a><a class="button" href="tel:+420775911005">+420 775 911 005</a></div></div></section>
</main><SiteFooter section="Servis"/>
<style>
  .service-site{background:#0b0b0b;color:#fff}.workshop-hero{position:relative;min-height:clamp(680px,84svh,850px);overflow:hidden}.workshop-hero>img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 58%;filter:saturate(.78) contrast(1.03) brightness(.96)}.workshop-hero__shade{position:absolute;inset:0;background:linear-gradient(90deg,rgba(0,0,0,.78),rgba(0,0,0,.08) 74%),linear-gradient(0deg,rgba(0,0,0,.68),transparent 48%)}.workshop-hero__copy{position:absolute;left:clamp(20px,5vw,78px);bottom:clamp(62px,7vw,105px);max-width:920px}.workshop-hero h1{margin:22px 0 27px;font-family:'Avenir Next Condensed','DIN Condensed','Helvetica Neue',sans-serif;font-size:clamp(54px,7.2vw,108px);line-height:.84;letter-spacing:-.05em;text-transform:uppercase}.workshop-hero__copy>p:last-child{max-width:600px;color:#d5d5d5;font-size:16px;line-height:1.65}.workshop-hero__cta{position:absolute;right:clamp(20px,4vw,60px);bottom:42px;font-size:10px;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.workshop-hero__cta span{margin-left:18px;color:var(--red);font-size:20px}.service-facts{display:grid;grid-template-columns:repeat(4,1fr);border-top:1px solid #383838;border-bottom:1px solid #383838}.service-facts div{display:flex;align-items:center;min-height:98px;padding:22px clamp(18px,3vw,42px)}.service-facts div+div{border-left:1px solid #383838}.service-facts strong{max-width:230px;font-size:13px;line-height:1.45}.diagnosis{display:grid;grid-template-columns:minmax(220px,.55fr) minmax(0,1.45fr);gap:clamp(55px,8vw,125px);padding-block:110px}.diagnosis aside>p:last-child{max-width:350px;margin-top:22px;color:#999;line-height:1.7}.service-ledger{border-top:1px solid #444}.service-ledger a{display:grid;grid-template-columns:100px minmax(240px,1fr) minmax(180px,.75fr);align-items:start;gap:24px;padding:29px 0;border-bottom:1px solid #444}.service-ledger span,.service-ledger small{color:#8d8d8d;font-size:11px;line-height:1.55}.service-ledger strong{font-size:clamp(27px,2.7vw,40px);line-height:1;letter-spacing:-.03em}.service-ledger a:hover strong{color:var(--red)}.ice-story{display:grid;grid-template-columns:.78fr 1.22fr;min-height:660px;background:#e4e2da;color:#0a0a0a}.ice-story__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(50px,6vw,92px)}.ice-story h2,.workshop h2{margin:20px 0 25px;font-size:clamp(42px,5vw,72px);line-height:.93;letter-spacing:-.045em}.ice-story__copy>p:not(.kicker){line-height:1.7}.ice-story__mosaic{display:grid;grid-template-columns:1fr .65fr;grid-template-rows:1fr 1fr;min-height:660px;max-height:760px}.ice-story__mosaic img{width:100%;height:100%;object-fit:cover}.ice-story__mosaic img:first-child{grid-row:1/-1;object-position:center 58%}.ice-story__mosaic img:nth-child(2){object-position:center 54%}.ice-story__mosaic img:nth-child(3){object-position:center 62%}.workshop{display:grid;grid-template-columns:1.15fr .85fr;min-height:620px}.workshop__image{overflow:hidden}.workshop__image img{width:100%;height:100%;object-fit:cover;object-position:center 58%}.workshop__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(45px,5vw,82px)}.workshop dl{margin:30px 0 0}.workshop dl div{display:grid;grid-template-columns:50px 1fr;padding:15px 0;border-top:1px solid #3a3a3a}.workshop dt{color:var(--red)}.workshop dd{margin:0}.service-contact{padding:100px 0;background:#191919}.service-contact h2{max-width:1000px;margin:18px 0 36px;font-size:clamp(46px,6vw,86px);line-height:.94;letter-spacing:-.045em}.service-contact .button{margin:0 8px 8px 0}
  @media(max-width:900px){.service-facts{grid-template-columns:1fr 1fr}.service-facts div:nth-child(3){border-left:0;border-top:1px solid #383838}.service-facts div:nth-child(4){border-top:1px solid #383838}.diagnosis,.ice-story,.workshop{grid-template-columns:1fr}.service-ledger a{grid-template-columns:90px 1fr}.service-ledger small{grid-column:2}.ice-story__mosaic{min-height:560px}.workshop__image{min-height:54vw}}@media(max-width:600px){.workshop-hero{min-height:640px}.workshop-hero__copy{bottom:54px}.workshop-hero h1{font-size:clamp(46px,13vw,54px)}.workshop-hero__copy>p:last-child{font-size:14px}.workshop-hero__cta{display:none}.service-facts{grid-template-columns:1fr}.service-facts div{min-height:68px}.service-facts div+div{border-left:0;border-top:1px solid #383838}.diagnosis{padding-block:78px}.service-ledger a{grid-template-columns:1fr}.service-ledger span,.service-ledger small{grid-column:auto}.ice-story__mosaic{min-height:440px;grid-template-columns:1.1fr .9fr}.ice-story__copy,.workshop__copy{padding:68px 18px}.service-contact{padding-block:78px}}
  .workshop-hero__cta{display:flex;align-items:center;gap:14px}.workshop-hero__cta span{margin:0;color:inherit;font-size:inherit}.workshop-hero__cta :global(svg){color:var(--red)}
  .workshop dl div{grid-template-columns:76px 1fr}.workshop dt{font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}
</style>
