---
import MicrositeHeader from '../MicrositeHeader.astro'
import SiteFooter from '../SiteFooter.astro'
import ArrowIcon from '../ArrowIcon.astro'
const links = [
  {label:'Vozy v nabídce',href:'/auta/vozy/'},{label:'Dovoz',href:'/auta/dovoz-vozidel/'},
  {label:'Prodej',href:'/auta/prodej-vaseho-vozu/'},{label:'Přeprava',href:'/auta/preprava-vozidel/'},
  {label:'Reference',href:'#reference'},{label:'Kontakt',href:'#kontakt'},
]
const vehicles = [
  {title:'Škoda Octavia RS Mk1', meta:'1.8T, 2001', image:'/media/vehicle-octavia-1.jpg', href:'/auta/vozy/skoda-octavia-rs-mk1/'},
  {title:'Jaguar XJ Sovereign', meta:'Britský grand tourer', image:'/media/vehicle-jaguar-1.jpg', href:'/auta/vozy/jaguar-xj-sovereign/'},
  {title:'Audi RS4', meta:'Avant, quattro', image:'/media/vehicle-audi-rs4-1.jpg', href:'/auta/vozy/audi-rs4/'},
]
const routes = [
  {title:'Dovoz vozu',text:'Pomůžeme s výběrem, prověříme historii i technický stav a zařídíme nákup, dopravu a registraci.',href:'/auta/dovoz-vozidel/'},
  {title:'Prodej vašeho vozu',text:'Vůz připravíme, profesionálně nafotíme, zveřejníme a převezmeme komunikaci i administrativu prodeje.',href:'/auta/prodej-vaseho-vozu/'},
  {title:'Krytá přeprava',text:'Bezpečný přesun sportovních, historických i nízkých vozů v uzavřeném přepravníku.',href:'/auta/preprava-vozidel/'},
]
---
<MicrositeHeader section="auta" tone="light" links={links}/>
<main class="autos" id="main-content">
  <section class="auto-hero">
    <div class="auto-hero__copy"><p class="kicker">Výběr, dovoz, prodej a přeprava</p><h1>Od prvního odkazu po předání klíčů.</h1><p>Vybereme vhodné nabídky, ověříme historii a technický stav a zařídíme dopravu i registraci. Stejně pečlivě připravíme váš vůz k prodeji.</p><div class="auto-hero__actions"><a class="button button--red" href="#cesty">Vybrat cestu</a><a class="text-link" href="/auta/vozy/">Vozy v nabídce</a></div></div>
    <figure><img src="/media/vehicle-audi-rs4-1.jpg" alt="Audi RS4 z nabídky Mužíček"/><figcaption>Prověření, prezentace, bezpečné předání</figcaption></figure>
  </section>
  <section class="route-index page-width" id="cesty">
    <header><p class="kicker">Jak vám můžeme pomoci</p><h2>Tři cesty.<br/>Jeden odpovědný partner.</h2></header>
    <div class="route-index__list">{routes.map((route)=><a href={route.href}><strong>{route.title}</strong><p>{route.text}</p><b><ArrowIcon/></b></a>)}</div>
  </section>
  <section class="inventory page-width" id="vozy">
    <header><div><p class="kicker">Aktuálně</p><h2>Vozy v nabídce</h2></div><a class="text-link" href="/auta/vozy/">Celá nabídka</a></header>
    <div class="vehicle-list">{vehicles.map((vehicle)=><a class="vehicle" href={vehicle.href}><span class="vehicle__image"><img src={vehicle.image} alt={vehicle.title} loading="lazy"/></span><span class="vehicle__copy"><strong>{vehicle.title}</strong><small>{vehicle.meta}</small></span><span class="vehicle__arrow"><ArrowIcon /></span></a>)}</div>
  </section>
  <section class="commission">
    <div class="commission__image"><img src="/media/transport-trailer.jpg" alt="Krytá přeprava automobilu Mužíček" loading="lazy"/></div>
    <div class="commission__copy"><p class="kicker">Auto na objednávku</p><h2>Od prvního odkazu po klíče v ruce.</h2><p>Vyhledáme nabídky, prověříme historii a technický stav, domluvíme nákup, dopravu i registraci. Předem víte, kdo řeší který krok.</p><div class="commission__links"><a href="/auta/dovoz-vozidel/"><span>Dovoz vozidel</span><ArrowIcon /></a><a href="/auta/preprava-vozidel/"><span>Krytá přeprava</span><ArrowIcon /></a><a href="/auta/prodej-vaseho-vozu/"><span>Prodej vašeho vozu</span><ArrowIcon /></a></div></div>
  </section>
  <section class="handover page-width">
    <header><p class="kicker">Postup dovozu</p><h2>Každý krok má jasný výstup.</h2></header>
    <ol><li><div><strong>Zadání</strong><p>Ujasníme typ vozu, rozpočet, termín a priority.</p></div></li><li><div><strong>Výběr a prověření</strong><p>Porovnáme nabídky, historii a technický stav.</p></div></li><li><div><strong>Nákup a logistika</strong><p>Převezmeme komunikaci, dokumenty a bezpečnou dopravu.</p></div></li><li><div><strong>Předání</strong><p>Vůz i dokumentaci projdeme osobně, bez skrytých kroků.</p></div></li></ol>
  </section>
  <section class="references page-width" id="reference"><div class="references__intro"><p class="kicker">Reference</p><h2>Auta, která jsme měli v rukou.</h2><p>Každý vůz má jiný příběh. Způsob práce zůstává stejný: znát fakta a nic neskrývat.</p></div><div class="references__rail"><figure><img src="/media/maserati-merak.jpg" alt="Maserati Merak" loading="lazy"/><figcaption>Maserati Merak</figcaption></figure><figure><img src="/media/aston-vanquish.jpg" alt="Aston Martin Vanquish" loading="lazy"/><figcaption>Aston Martin Vanquish</figcaption></figure><figure><img src="/media/ford-escort.jpg" alt="Ford Escort" loading="lazy"/><figcaption>Ford Escort</figcaption></figure></div></section>
  <section class="auto-contact" id="kontakt"><div class="page-width"><p class="kicker">Máte konkrétní vůz nebo teprve hledáte?</p><h2>Začněme zadáním.</h2><div><a class="button button--red" href="mailto:info@muzicek.com?subject=Poptávka%20Muzicek%20Auta">Napsat poptávku</a><a class="button" href="tel:+420775911005">+420 775 911 005</a></div></div></section>
</main><SiteFooter section="Auta"/>
<style>
  .autos{background:#f4f3ee}.auto-hero{min-height:clamp(700px,84svh,850px);display:grid;grid-template-columns:minmax(420px,.82fr) minmax(0,1.18fr);padding-top:92px;background:#ebe9e2}.auto-hero__copy{display:flex;flex-direction:column;justify-content:flex-end;padding:105px clamp(32px,5vw,82px) 58px}.auto-hero h1{max-width:680px;margin:22px 0 26px;font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(54px,5.7vw,88px);font-weight:400;line-height:.9;letter-spacing:-.05em}.auto-hero__copy>p:not(.kicker){max-width:520px;margin:0 0 30px;font-size:16px;line-height:1.65}.auto-hero__actions{display:flex;align-items:center;gap:28px;flex-wrap:wrap}.auto-hero figure{position:relative;margin:0;overflow:hidden}.auto-hero figure img{width:100%;height:100%;object-fit:cover;object-position:48% center}.auto-hero figcaption{position:absolute;right:22px;bottom:20px;padding:10px 13px;background:#f4f3ee;font-size:9px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.route-index{display:grid;grid-template-columns:.5fr 1.5fr;gap:clamp(50px,8vw,125px);padding-block:110px}.route-index header{position:sticky;top:120px;align-self:start}.route-index h2{margin:20px 0 0;font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(43px,5vw,72px);font-weight:400;line-height:.94;letter-spacing:-.045em}.route-index__list{border-top:1px solid #999}.route-index__list a{display:grid;grid-template-columns:.78fr 1fr 34px;gap:28px;align-items:start;padding:26px 0;border-bottom:1px solid #999}.route-index__list strong{font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(26px,2.7vw,40px);font-weight:400;line-height:1}.route-index__list p{max-width:470px;margin:0;color:#5b5a56;font-size:13px;line-height:1.65}.route-index__list b{display:grid;place-items:center;color:var(--red);transition:transform .2s}.route-index__list a:hover b{transform:translateX(4px)}.inventory{padding-block:110px}.inventory header{display:flex;justify-content:space-between;align-items:end;gap:30px;margin-bottom:44px}.inventory h2,.references h2{margin:14px 0 0;font-size:clamp(44px,5.2vw,76px);line-height:.94;letter-spacing:-.04em}.vehicle-list{border-top:1px solid #aaa}.vehicle{display:grid;grid-template-columns:54px minmax(170px,320px) 1fr 40px;align-items:center;gap:clamp(20px,4vw,65px);padding:16px 0;border-bottom:1px solid #aaa}.vehicle__number{font-size:10px}.vehicle__image{height:136px;overflow:hidden}.vehicle__image img{width:100%;height:100%;object-fit:cover;object-position:center 55%;transition:transform .55s}.vehicle__copy{display:grid;gap:9px}.vehicle__copy strong{font-size:clamp(24px,2.7vw,40px);letter-spacing:-.03em}.vehicle__copy small{font-size:12px;text-transform:uppercase;letter-spacing:.1em}.vehicle__arrow{font-size:26px;color:var(--red)}.vehicle:hover img{transform:scale(1.035)}.commission{display:grid;grid-template-columns:1.12fr .88fr;min-height:650px;background:#0b0b0b;color:white}.commission__image{min-height:650px;overflow:hidden}.commission__image img{width:100%;height:100%;object-fit:cover;object-position:center 52%}.commission__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(48px,6vw,96px)}.commission h2{max-width:620px;margin:22px 0 25px;font-size:clamp(40px,4.6vw,66px);line-height:.97;letter-spacing:-.035em}.commission__copy>p:not(.kicker){max-width:560px;color:#bbb;line-height:1.7}.commission__links{display:grid;margin-top:38px;border-top:1px solid #444}.commission__links a{padding:15px 0;border-bottom:1px solid #444;font-size:13px}.commission__links a::after{content:'\2192';float:right;color:var(--red)}.handover{display:grid;grid-template-columns:.65fr 1.35fr;gap:clamp(50px,8vw,125px);padding-block:110px}.handover h2{margin:20px 0 0;font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(43px,5vw,72px);font-weight:400;line-height:.94;letter-spacing:-.045em}.handover ol{margin:0;padding:0;list-style:none;border-top:1px solid #999}.handover li{padding:21px 0;border-bottom:1px solid #999}.handover strong{font-size:18px}.handover li p{margin:7px 0 0;color:#5b5a56;line-height:1.6}.references{display:grid;grid-template-columns:minmax(280px,.55fr) minmax(0,1.45fr);gap:64px;padding-block:110px}.references__intro p:last-child{max-width:390px;line-height:1.7}.references__rail{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.references figure{margin:0}.references figure:nth-child(2){margin-top:32px}.references figure:nth-child(3){margin-top:64px}.references img{width:100%;aspect-ratio:4/5;object-fit:cover}.references figure:nth-child(1) img{object-position:58% center}.references figure:nth-child(2) img{object-position:center}.references figure:nth-child(3) img{object-position:48% center}.references figcaption{margin-top:10px;font-size:10px;font-weight:800;text-transform:uppercase;letter-spacing:.1em}.auto-contact{padding:100px 0;background:#dedbd2}.auto-contact h2{margin:18px 0 34px;font-size:clamp(52px,7vw,98px);line-height:.92;letter-spacing:-.05em}.auto-contact .button{margin:0 8px 8px 0}.auto-contact .button:not(.button--red){color:#111}
  @media(max-width:900px){.auto-hero{grid-template-columns:1fr;padding-top:76px}.auto-hero__copy{min-height:540px;padding-top:140px}.auto-hero figure{min-height:54vw}.route-index,.handover,.commission,.references{grid-template-columns:1fr}.route-index header{position:static}.commission__image{min-height:520px}.references__rail{gap:9px}.references figure:nth-child(2){margin-top:24px}.references figure:nth-child(3){margin-top:48px}}@media(max-width:600px){.auto-hero__copy{min-height:500px;padding:125px 18px 42px}.auto-hero h1{font-size:46px}.auto-hero__actions{align-items:flex-start;flex-direction:column}.route-index,.handover{padding-block:78px}.route-index__list a{grid-template-columns:1fr 30px}.route-index__list p{grid-column:1}.vehicle{grid-template-columns:1fr 32px;gap:14px}.vehicle__number{display:none}.vehicle__image{grid-column:1/-1;height:52vw}.vehicle__copy strong{font-size:26px}.inventory{padding-block:78px}.commission__image{min-height:80vw}.references{padding-block:78px;gap:40px}.references__rail{overflow-x:auto;grid-template-columns:repeat(3,76vw)}.references figure:nth-child(n){margin-top:0}}
  .vehicle{grid-template-columns:minmax(170px,320px) 1fr 40px}.vehicle__arrow{display:grid;place-items:center;font-size:initial;transition:transform .2s ease}.vehicle:hover .vehicle__arrow{transform:translateX(4px)}
  .commission__links a{display:flex;align-items:center;justify-content:space-between}.commission__links a::after{content:none}.commission__links :global(svg){color:var(--red)}
  @media(max-width:600px){.vehicle{grid-template-columns:1fr 32px}}
</style>
