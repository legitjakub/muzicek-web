---
const {area, service, car} = Astro.props as {area: string; service?: string; car?: string}
---
<form class="inquiry" data-inquiry data-area={area} data-service={service || ''}>
  {area === 'servis' && <p class="inquiry__head label"><span>Zakázkový list</span><span>Mužíček · Servis</span></p>}
  <div class="inquiry__row"><label>Jméno<input name="name" autocomplete="name" required/></label><label>Telefon<input name="phone" type="tel" autocomplete="tel" required/></label></div>
  <div class="inquiry__row"><label>E-mail<input name="email" type="email" autocomplete="email" required/></label><label>Vůz<input name="car" placeholder="Značka, model, rok" value={car}/></label></div>
  {area === 'auta' && <label>O jakou pomoc máte zájem?<select name="intent"><option>Koupě / konkrétní vůz</option><option>Zakázkový dovoz</option><option>Prodej vlastního vozu</option><option>Přeprava</option></select></label>}
  {area === 'servis' && <label>Co se s vozem děje?<textarea name="message" rows="4" placeholder="Popište problém, požadovanou práci nebo úpravu" required></textarea></label>}
  {area === 'detailing' && <label>Co chcete na voze řešit?<textarea name="message" rows="4" placeholder="Stav vozu, požadovaný výsledek a přibližný termín" required></textarea></label>}
  {area === 'auta' && <label>Vaše zpráva<textarea name="message" rows="4" placeholder="Rozpočet, termín a důležité požadavky"></textarea></label>}
  <div class="inquiry__foot"><p>Po odeslání se otevře e-mail s předvyplněnou poptávkou. Zkontrolujte ji a odešlete přímo ze své pošty.</p><button class="btn" type="submit"><span>Připravit poptávku</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M3 12h17M14 6l6 6-6 6"/></svg></button></div>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-inquiry]').forEach((form)=>form.addEventListener('submit',(event)=>{
    event.preventDefault()
    const data=new FormData(form)
    const subject=`Poptávka ${form.dataset.service||`Mužíček ${form.dataset.area}`}`
    const body=[`Jméno: ${data.get('name')}`,`Telefon: ${data.get('phone')}`,`E-mail: ${data.get('email')}`,`Vůz: ${data.get('car')||'—'}`,data.get('intent')?`Typ poptávky: ${data.get('intent')}`:'',`Zpráva:\n${data.get('message')||'—'}`].filter(Boolean).join('\n')
    window.location.href=`mailto:info@muzicek.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
  }))
</script>
<style>
  .inquiry { display: grid; gap: 26px; }
  .inquiry__row { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; }
  .inquiry label { display: grid; gap: 4px; font: 600 13px var(--f-display); letter-spacing: .16em; text-transform: uppercase; color: var(--mute); }
  .inquiry input, .inquiry select, .inquiry textarea { width: 100%; padding: 12px 0; border: 0; border-bottom: 1px solid var(--line); border-radius: 0; background: transparent; color: var(--fg); font: 400 18px var(--f-body); letter-spacing: 0; text-transform: none; outline: none; transition: border-color .25s; }
  .inquiry select option { color: #111; }
  .inquiry textarea { resize: vertical; min-height: 120px; }
  .inquiry input:focus, .inquiry select:focus, .inquiry textarea:focus { border-color: var(--red); }
  .inquiry__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 22px 36px; padding-top: 6px; }
  .inquiry__foot p { max-width: 44ch; font-size: 13px; line-height: 1.5; color: var(--mute); }
  @media (max-width: 620px) { .inquiry__row { grid-template-columns: 1fr; } }
  .inquiry__head { display: none; }
  /* Servis: the form is a work order */
  :global([data-world='servis']) .inquiry { counter-reset: f; gap: 0; border: 1px solid var(--line); background: rgba(255,255,255,.02); }
  :global([data-world='servis']) .inquiry__head { display: flex; justify-content: space-between; padding: 14px 18px; border-bottom: 1px solid var(--line); background: var(--steel-2); color: var(--fg); }
  :global([data-world='servis']) .inquiry__row { gap: 0; }
  :global([data-world='servis']) .inquiry label { counter-increment: f; padding: 14px 18px 4px; border-bottom: 1px solid var(--line); }
  :global([data-world='servis']) .inquiry__row label + label { border-left: 1px solid var(--line); }
  :global([data-world='servis']) .inquiry label::before { content: counter(f, decimal-leading-zero); margin-right: 10px; color: var(--red); }
  :global([data-world='servis']) .inquiry input, :global([data-world='servis']) .inquiry select, :global([data-world='servis']) .inquiry textarea { border-bottom: 0; padding-block: 10px 14px; }
  :global([data-world='servis']) .inquiry__foot { padding: 18px; }
  /* Auta: a sheet of paper on the desk */
  :global([data-world='auta']) .inquiry { padding: clamp(22px, 3vw, 44px); background: #fff; box-shadow: 0 40px 70px -40px rgba(0,0,0,.28), 0 0 0 1px rgba(0,0,0,.05); }
  :global([data-world='auta']) .inquiry label { font-family: var(--f-serif); font-size: 17px; letter-spacing: 0; text-transform: none; color: var(--mute); }
  /* Detailing: a lit panel */
  :global([data-world='detailing']) .inquiry { padding: clamp(22px, 3vw, 44px); background: linear-gradient(135deg, rgba(255,255,255,.9), rgba(255,255,255,.45)); box-shadow: inset 0 0 0 1px rgba(255,255,255,.8), 0 30px 60px -40px rgba(0,0,0,.3); }
</style>
