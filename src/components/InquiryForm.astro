---
const {area, service} = Astro.props as {area: string; service?: string}
---
<form class="inquiry" data-inquiry data-area={area} data-service={service || ''}>
  <div class="inquiry__row"><label>Jméno<input name="name" autocomplete="name" required/></label><label>Telefon<input name="phone" type="tel" autocomplete="tel" required/></label></div>
  <div class="inquiry__row"><label>E-mail<input name="email" type="email" autocomplete="email" required/></label><label>Vůz<input name="car" placeholder="Značka, model, rok"/></label></div>
  {area === 'auta' && <label>O jakou pomoc máte zájem?<select name="intent"><option>Koupě / konkrétní vůz</option><option>Zakázkový dovoz</option><option>Prodej vlastního vozu</option><option>Přeprava</option></select></label>}
  {area === 'servis' && <label>Co se s vozem děje?<textarea name="message" rows="4" placeholder="Popište problém, požadovanou práci nebo úpravu" required></textarea></label>}
  {area === 'detailing' && <label>Co chcete na voze řešit?<textarea name="message" rows="4" placeholder="Stav vozu, požadovaný výsledek a přibližný termín" required></textarea></label>}
  {area === 'auta' && <label>Vaše zpráva<textarea name="message" rows="4" placeholder="Rozpočet, termín a důležité požadavky"></textarea></label>}
  <div class="inquiry__foot"><p>Po odeslání se otevře e-mail s předvyplněnou poptávkou. Zkontrolujte ji a odešlete přímo ze své pošty.</p><button class="button button--red" type="submit">Připravit poptávku</button></div>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-inquiry]').forEach((form)=>form.addEventListener('submit',(event)=>{
    event.preventDefault()
    const data=new FormData(form)
    const subject=`Poptávka ${form.dataset.service||`Mužíček ${form.dataset.area}`}`
    const body=[`Jméno: ${data.get('name')}`,`Telefon: ${data.get('phone')}`,`E-mail: ${data.get('email')}`,`Vůz: ${data.get('car')||'—'}`,data.get('intent')?`Typ poptávky: ${data.get('intent')}`:'',`Zpráva:\n${data.get('message')||'—'}`].filter(Boolean).join('\n')
    window.location.href=`mailto:info@muzicek.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`
  }))
</script>
<style>
  .inquiry{display:grid;gap:22px}.inquiry__row{display:grid;grid-template-columns:1fr 1fr;gap:22px}.inquiry label{display:grid;gap:9px;font-size:10px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.inquiry input,.inquiry select,.inquiry textarea{width:100%;border:0;border-bottom:1px solid #777;border-radius:0;padding:13px 0;background:transparent;color:inherit;font-size:16px;font-weight:400;letter-spacing:0;text-transform:none;outline:none}.inquiry textarea{border:1px solid #777;padding:16px;resize:vertical}.inquiry input:focus,.inquiry select:focus,.inquiry textarea:focus{border-color:var(--red)}.inquiry__foot{display:flex;justify-content:space-between;align-items:center;gap:30px}.inquiry__foot p{max-width:430px;margin:0;color:#777;font-size:11px;line-height:1.55}.inquiry button{cursor:pointer}@media(max-width:620px){.inquiry__row{grid-template-columns:1fr}.inquiry__foot{align-items:flex-start;flex-direction:column-reverse}}
</style>
