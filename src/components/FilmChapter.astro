---
const {videoId, title, image, caption} = Astro.props as {videoId: string; title: string; image: string; caption?: string}
---
<section class="film" data-video={videoId}>
  <button class="film__poster" type="button" aria-label={`Přehrát video ${title}`} style={`background-image:url('${image}')`}>
    <span class="film__shade"></span>
    <span class="film__copy"><b>Přehrát film</b><strong>{title}</strong>{caption && <small>{caption}</small>}</span>
    <span class="film__play" aria-hidden="true">▶</span>
  </button>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.film[data-video]').forEach((film) => {
    film.querySelector('button')?.addEventListener('click', () => {
      const id = film.dataset.video
      const iframe = document.createElement('iframe')
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`
      iframe.title = film.querySelector('strong')?.textContent || 'Video Mužíček'
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
      iframe.allowFullscreen = true
      film.replaceChildren(iframe)
    }, {once:true})
  })
</script>
<style>
  .film { width:100%; aspect-ratio:16/8.3; min-height:480px; background:#090909; }
  .film__poster { position:relative; width:100%; height:100%; border:0; padding:0; overflow:hidden; background:center/cover no-repeat; color:white; text-align:left; cursor:pointer; }
  .film__poster::before { content:''; position:absolute; inset:0; background:inherit; transition:transform .8s cubic-bezier(.2,.8,.2,1); }
  .film__poster:hover::before { transform:scale(1.025); }
  .film__shade { position:absolute; inset:0; background:linear-gradient(90deg,rgba(0,0,0,.78),rgba(0,0,0,.05) 68%),linear-gradient(0deg,rgba(0,0,0,.45),transparent); }
  .film__copy { position:absolute; left:clamp(24px,6vw,96px); bottom:clamp(28px,7vw,90px); max-width:710px; display:grid; gap:12px; }
  .film__copy b { color:var(--red); font-size:10px; letter-spacing:.18em; text-transform:uppercase; }
  .film__copy strong { font-size:clamp(34px,5.6vw,82px); line-height:.92; letter-spacing:-.04em; }
  .film__copy small { font-size:14px; }
  .film__play { position:absolute; right:clamp(24px,6vw,96px); bottom:clamp(28px,7vw,90px); display:grid; place-items:center; width:72px; height:72px; padding-left:4px; border:1px solid white; border-radius:50%; }
  .film iframe { width:100%; height:100%; border:0; }
  @media(max-width:700px){.film{min-height:540px;aspect-ratio:auto}.film__play{right:22px;top:50%;bottom:auto;width:58px;height:58px}.film__copy{left:22px;right:22px;bottom:35px}}
</style>
