---
import Img from './Img.astro'
const {videoId, title, kicker = 'Film', text} = Astro.props as {videoId: string; title: string; kicker?: string; text?: string}
---
<section class="film wrap" data-video={videoId} aria-labelledby={`film-${videoId}`}>
  <div class="film__copy">
    <p class="label">{kicker}</p>
    <h2 id={`film-${videoId}`} class="display t-l">{title}</h2>
    {text && <p class="lede mute">{text}</p>}
    <p class="film__note">Video se načte z YouTube až po kliknutí.</p>
  </div>
  <div class="film__player frame">
    <button class="film__poster" type="button" aria-label={`Přehrát video: ${title}`}>
      <Img id="film-corvette" class="cover" alt="" sizes="(min-width: 900px) 30vw, 80vw" />
      <span class="film__play" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span>
    </button>
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.film[data-video]').forEach((film) => {
    const btn = film.querySelector('button')
    btn?.addEventListener('click', () => {
      const iframe = document.createElement('iframe')
      iframe.src = `https://www.youtube-nocookie.com/embed/${film.dataset.video}?autoplay=1&rel=0`
      iframe.title = film.querySelector('h2')?.textContent || 'Video Mužíček'
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'
      iframe.allowFullscreen = true
      iframe.className = 'cover'
      btn.replaceWith(iframe)
    }, {once: true})
  })
</script>
<style>
  .film { display: grid; gap: 40px; padding-block: clamp(80px, 11vw, 170px); align-items: center; }
  .film__copy { display: grid; gap: 22px; align-content: center; }
  .film__note { font-size: 12px; color: var(--mute); }
  .film__player { width: min(100%, 360px); aspect-ratio: 9 / 16; justify-self: start; }
  .film__poster { position: absolute; inset: 0; width: 100%; padding: 0; border: 0; cursor: pointer; background: #111; }
  .film__poster :global(img) { transition: transform 1.2s var(--ease); }
  .film__poster:hover :global(img) { transform: scale(1.04); }
  .film__poster::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.55), transparent 50%); }
  .film__play { position: absolute; z-index: 1; left: 50%; top: 50%; width: 76px; height: 76px; margin: -38px 0 0 -38px; display: grid; place-items: center; color: #fff; background: var(--red); transition: transform .4s var(--ease); }
  .film__play svg { width: 30px; height: 30px; }
  .film__poster:hover .film__play { transform: scale(1.08); }
  @media (min-width: 900px) { .film { grid-template-columns: 1.1fr .9fr; gap: 8vw; } .film__player { justify-self: end; width: min(100%, 400px); } }
</style>
