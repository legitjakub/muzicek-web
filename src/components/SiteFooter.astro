---
import {u} from '../lib/url'
import {worlds, contact} from '../data/site'
---
<footer class="site-footer" id="kontakt">
  <div class="site-footer__cols">
    <div>
      <h2>Ateliér</h2>
      <p class="site-footer__lede">Vůz, práce a lidé, kteří za ní stojí.</p>
    </div>
    <div>
      <h2>Navštivte nás</h2>
      <address>{contact.street}<br />{contact.zip} {contact.city}<br />{contact.hours}</address>
    </div>
    <div>
      <h2>Kontakt</h2>
      <ul>
        <li><a href={contact.phoneHref}>{contact.phone}</a></li>
        <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>
        <li><a href={contact.instagram} rel="noopener" target="_blank">Instagram</a></li>
      </ul>
    </div>
    <div>
      <h2>Světy</h2>
      <ul>
        {worlds.map((w) => <li><a href={u(w.href)}>{w.num} · {w.label}</a></li>)}
        <li><a href={u('/realizace/')}>Realizace</a></li>
      </ul>
    </div>
  </div>
  <div class="site-footer__word" aria-hidden="true">Mužíček</div>
  <div class="site-footer__meta"><span>© {new Date().getFullYear()} Mužíček</span><span>Jablonec nad Nisou</span></div>
</footer>
