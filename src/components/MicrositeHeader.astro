---
type Link = {label: string; href: string}
const {section, tone = 'dark', links = []} = Astro.props as {section: string; tone?: 'dark' | 'light'; links: Link[]}
---

<header class:list={['microsite-header', `microsite-header--${tone}`]}>
  <a class="skip-link" href="#main-content">Přejít na obsah</a>
  <div class="header-shell">
    <a class="identity" href={`/${section}/`} aria-label={`Mužíček ${section} — domů`}>
      <img src="/images/muzicek-mark.png" alt="" />
    </a>
    <nav class="desktop-nav" aria-label={`Navigace ${section}`}>
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu"><span>Menu</span><i></i></button>
  </div>
  <div class="section-switcher" aria-label="Přepnout část webu">
    <a href="/">Přehled</a><a class:list={{active:section==='auta'}} href="/auta/" aria-current={section==='auta'?'page':undefined}>Auta</a><a class:list={{active:section==='servis'}} href="/servis/" aria-current={section==='servis'?'page':undefined}>Servis</a><a class:list={{active:section==='detailing'}} href="/detailing/" aria-current={section==='detailing'?'page':undefined}>Detailing</a>
  </div>
  <nav class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <p>Právě prohlížíte: Mužíček {section}</p>
    {links.map((link) => <a href={link.href}>{link.label}</a>)}
    <div class="mobile-areas" aria-label="Další části webu"><a href="/">Přehled</a><a href="/auta/">Auta</a><a href="/servis/">Servis</a><a href="/detailing/">Detailing</a></div>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button')
  const menu = document.querySelector<HTMLElement>('.mobile-menu')
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') !== 'true'
    button.setAttribute('aria-expanded', String(open))
    menu?.setAttribute('aria-hidden', String(!open))
    document.body.classList.toggle('menu-open', open)
  })
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    button?.setAttribute('aria-expanded', 'false')
    menu?.setAttribute('aria-hidden', 'true')
    document.body.classList.remove('menu-open')
  }))
</script>

<style>
  .microsite-header { position:absolute; z-index:50; inset:0 0 auto; color:#0a0a0a; }
  .skip-link { position:fixed; z-index:100; top:10px; left:10px; padding:10px 14px; background:#fff; color:#111; font-size:11px; font-weight:800; transform:translateY(-160%); transition:transform .15s; }
  .skip-link:focus { transform:translateY(0); }
  .microsite-header--dark { color:#fff; }
  .header-shell { height:92px; display:grid; grid-template-columns:minmax(230px,1fr) auto minmax(230px,1fr); align-items:center; gap:28px; padding:0 clamp(20px,4vw,60px); border-bottom:1px solid color-mix(in srgb,currentColor 32%,transparent); }
  .identity { display:flex; align-items:center; justify-self:start; }
  .identity img { width:82px; height:38px; object-fit:contain; }
  .microsite-header--light .identity img { filter:brightness(0); }
  .microsite-header--dark .identity img { filter:brightness(0) invert(1); }
  .desktop-nav { display:flex; gap:clamp(18px,2.5vw,38px); font-size:10px; font-weight:800; letter-spacing:.09em; text-transform:uppercase; }
  .desktop-nav a { position:relative; padding:37px 0 34px; }
  .desktop-nav a::after { content:''; position:absolute; right:0; bottom:29px; left:0; height:2px; background:var(--red); transform:scaleX(0); transform-origin:right; transition:transform .25s ease; }
  .desktop-nav a:hover::after,.desktop-nav a:focus-visible::after { transform:scaleX(1); transform-origin:left; }
  .menu-button { display:none; justify-self:end; border:0; background:transparent; color:inherit; font-size:10px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .section-switcher { position:absolute; right:clamp(20px,4vw,60px); top:108px; display:flex; gap:16px; font-size:9px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .section-switcher .active { color:var(--red); }
  .mobile-menu { position:fixed; inset:0; z-index:-1; display:grid; align-content:center; gap:0; padding:100px 24px 32px; background:#080808; color:white; opacity:0; pointer-events:none; transition:opacity .25s; }
  .mobile-menu[aria-hidden='false'] { opacity:1; pointer-events:auto; }
  .mobile-menu>p { margin:0 0 16px; color:#777; font-size:9px; font-weight:800; letter-spacing:.12em; text-transform:uppercase; }
  .mobile-menu a { padding:18px 0; border-bottom:1px solid #333; font-size:clamp(26px,8vw,46px); font-weight:700; }
  .mobile-areas { display:flex; gap:18px; padding-top:25px; }
  .mobile-areas a { padding:0; border:0; color:#aaa; font-size:10px; font-weight:800; letter-spacing:.1em; text-transform:uppercase; }
  .mobile-areas a:hover { color:#fff; }
  :global(body.menu-open) .microsite-header { color:#fff; }
  :global(body.menu-open) .microsite-header--light .identity img { filter:brightness(0) invert(1); }
  :global(body.menu-open) .header-shell { border-color:#333; }
  @media(max-width:1080px){ .desktop-nav{display:none}.menu-button{display:block}.header-shell{grid-template-columns:1fr auto}.section-switcher{display:none} }
  @media(max-width:580px){ .header-shell{height:76px;padding-inline:18px}.identity img{width:72px}.menu-button{display:block} }
</style>
