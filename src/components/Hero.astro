---
import Img from './Img.astro'
import {u} from '../lib/url'
import type {WorldKey} from '../data/site'

type Action = {label: string; href: string; ghost?: boolean}
type Props = {
  world: WorldKey; image: string; pos?: string; alt: string; num: string; kicker: string; title: string[]
  lede?: string; actions?: Action[]; strip?: {label: string; href: string}[]; caption?: {text: string; href?: string}
}
const {world, image, pos, alt, num, kicker, title, lede, actions = [], strip = [], caption} = Astro.props as Props
---
<header class="hero" data-hero={world}>
  <div class="hero__media"><Img id={image} class="cover" priority alt={alt} pos={pos} /></div>
  {world === 'servis' && <div class="hero__ticks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>}
  <div class="hero__shade" aria-hidden="true"></div>
  {world === 'detailing' && <div class="hero__wipe" aria-hidden="true"></div>}
  <div class="hero__body wrap">
    <p class="label hero__kicker" data-reveal="fade" style="--delay:.5s"><b class="num">{num}</b><span>{kicker}</span></p>
    <h1 class:list={['hero__title', world === 'auta' ? 'serif' : 'display']} data-split style="--delay:.25s">
      {title.map((line, i) => <Fragment>{line}{i < title.length - 1 && <br />}</Fragment>)}
    </h1>
    <div class="hero__foot">
      {lede && <p class="hero__lede" data-reveal="up" style="--delay:.9s">{lede}</p>}
      {actions.length > 0 && (
        <div class="hero__actions" data-reveal="up" style="--delay:1.1s">
          {actions.map((a) => <a class:list={['link']} href={a.href.startsWith('#') ? a.href : u(a.href)}>{a.label}</a>)}
        </div>
      )}
    </div>
  </div>
  {strip.length > 0 && <ul class="hero__strip wrap" data-stagger>{strip.map((s, i) => <li><a href={s.href.startsWith('#') ? s.href : u(s.href)}><b class="num">0{i + 1}</b><span>{s.label}</span></a></li>)}</ul>}
  {caption && <p class="hero__caption label">{caption.href ? <a href={u(caption.href)}>{caption.text}</a> : caption.text}</p>}
</header>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; isolation: isolate; color: #fff; background: #0b0b0c; }
  .hero__media { position: absolute; inset: 0; z-index: -3; }
  .hero__shade { position: absolute; inset: 0; z-index: -2; background: linear-gradient(0deg, rgba(5,5,6,.82), rgba(5,5,6,.08) 58%), linear-gradient(90deg, rgba(5,5,6,.42), transparent 62%); }
  .hero__body { display: grid; gap: clamp(14px, 2.2vh, 26px); padding-top: calc(var(--header-h) + 50px); padding-bottom: clamp(30px, 6vh, 66px); }
  .hero__kicker { display: flex; gap: 14px; align-items: baseline; color: rgba(255,255,255,.82); }
  .hero__kicker b { color: #fff; }
  .hero__kicker span::before { content: ''; display: inline-block; width: 30px; height: 1px; margin-right: 14px; vertical-align: middle; background: currentColor; }
  .hero__title { max-width: 14ch; font-size: clamp(60px, 11.2vw, 210px); }
  .hero__foot { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 22px 40px; padding-top: clamp(14px, 2.4vh, 28px); border-top: 1px solid rgba(255,255,255,.3); }
  .hero__lede { max-width: 46ch; font-size: clamp(16px, 1.35vw, 20px); line-height: 1.45; color: rgba(255,255,255,.9); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 18px 34px; }
  .hero__caption { position: absolute; top: calc(var(--header-h) + 28px); right: var(--gutter); color: rgba(255,255,255,.8); }
  .hero__caption a { border-bottom: 1px solid currentColor; padding-bottom: 3px; }

  /* CARS — showroom: bright, serif, a frame that opens */
  [data-hero='auta'] .hero__title { font-size: clamp(54px, 10.2vw, 196px); max-width: none; letter-spacing: -.035em; line-height: .9; }
  [data-hero='auta'] .hero__shade { background: linear-gradient(0deg, rgba(8,8,9,.7), rgba(8,8,9,0) 52%), linear-gradient(180deg, rgba(8,8,9,.28), transparent 22%); }
  [data-hero='auta'] .hero__media { animation: frame-open 1.9s var(--ease) both; }
  [data-hero='auta'] .hero__media :global(img) { animation: lens-settle 2.8s var(--ease) both; }
  @keyframes frame-open { from { clip-path: inset(9% 9% 9% 9%); } to { clip-path: inset(0); } }
  @keyframes lens-settle { from { transform: scale(1.16); } to { transform: scale(1.01); } }

  /* SERVIS — workshop: desaturated, technical strip, corner marks */
  [data-hero='servis'] .hero__media { filter: saturate(.72) contrast(1.06) brightness(.92); animation: shutter 1.5s var(--ease) both; }
  [data-hero='servis'] .hero__media :global(img) { animation: lens-settle 2.4s var(--ease) both; }
  [data-hero='servis'] .hero__shade { background: linear-gradient(0deg, rgba(4,6,8,.94), rgba(4,6,8,.15) 70%), rgba(8,14,22,.22); }
  [data-hero='servis'] .hero__body { padding-bottom: clamp(120px, 17vh, 170px); }
  [data-hero='servis'] .hero__title { max-width: none; font-size: clamp(54px, 9.4vw, 184px); }
  @keyframes shutter { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  .hero__ticks i { position: absolute; z-index: 1; width: 26px; height: 26px; border: 0 solid rgba(255,255,255,.7); }
  .hero__ticks i:nth-child(1) { top: calc(var(--header-h) + 18px); left: var(--gutter); border-width: 1px 0 0 1px; }
  .hero__ticks i:nth-child(2) { top: calc(var(--header-h) + 18px); right: var(--gutter); border-width: 1px 1px 0 0; }
  .hero__ticks i:nth-child(3) { bottom: 22px; left: var(--gutter); border-width: 0 0 1px 1px; }
  .hero__ticks i:nth-child(4) { bottom: 22px; right: var(--gutter); border-width: 0 1px 1px 0; }
  .hero__strip { position: absolute; inset: auto 0 0; display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid rgba(255,255,255,.28); background: linear-gradient(0deg, rgba(4,6,8,.55), transparent); }
  .hero__strip li + li { border-left: 1px solid rgba(255,255,255,.2); }
  .hero__strip a { display: flex; gap: 12px; align-items: baseline; padding: 18px 16px 24px 0; font: 600 14px/1.25 var(--f-display); letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.9); transition: color .25s; }
  .hero__strip li + li a { padding-left: 16px; }
  .hero__strip a:hover span { text-decoration: underline; text-underline-offset: 5px; }
  .hero__strip b { color: var(--red); }
  @media (max-width: 800px) { .hero__strip { grid-template-columns: 1fr 1fr; } .hero__strip li:nth-child(3) { border-left: 0; } .hero__strip li:nth-child(3) a { padding-left: 0; } [data-hero='servis'] .hero__body { padding-bottom: 190px; } }

  /* DETAILING — surface: a panel of studio light wipes away, leaving a reflection */
  [data-hero='detailing'] .hero__title { max-width: 10ch; }
  [data-hero='detailing'] .hero__shade { background: linear-gradient(0deg, rgba(6,8,10,.82), rgba(6,8,10,0) 58%), linear-gradient(90deg, rgba(6,8,10,.5), transparent 66%); }
  [data-hero='detailing'] .hero__media :global(img) { animation: lens-settle 2.8s var(--ease) both; }
  .hero__wipe { position: absolute; inset: 0; z-index: 2; pointer-events: none; background: linear-gradient(100deg, var(--studio) 0 60%, #fff 100%); transform-origin: right; animation: surface-wipe 1.5s .15s var(--ease-io) both; }
  .hero__wipe::after { content: ''; position: absolute; inset: 0 0 0 auto; width: 18vw; background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.85)); }
  @keyframes surface-wipe { from { transform: scaleX(1); } to { transform: scaleX(0); } }
  :global(.rm) .hero__wipe { display: none; }
  :global(.rm) .hero__media, :global(.rm) .hero__media :global(img) { animation: none !important; }
  @media (max-width: 700px) { .hero__title { font-size: clamp(54px, 17vw, 110px); } .hero__caption { display: none; } }
</style>
