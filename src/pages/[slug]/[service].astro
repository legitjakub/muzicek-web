---
import {VisualEditing} from '@sanity/astro/visual-editing'
import {sanity} from '../../lib/sanity'
import '../../styles/site.css'
import MicrositeHeader from '../../components/MicrositeHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import FilmChapter from '../../components/FilmChapter.astro'
import InquiryForm from '../../components/InquiryForm.astro'
import ArrowIcon from '../../components/ArrowIcon.astro'
import MotionDirector from '../../components/MotionDirector.astro'

type Area={title:string;slug:string}
type Step={title:string;text?:string}
type Service={_id:string;title:string;slug:string;summary:string;introTitle?:string;details?:string;benefits?:string[];duration?:string;priceNote?:string;process?:Step[];area:Area}
export async function getStaticPaths(){
 const services=await sanity.fetch<Service[]>(`*[_type=="service"]|order(area->order asc,order asc){_id,title,"slug":slug.current,summary,introTitle,details,benefits,duration,priceNote,process,"area":area->{title,"slug":slug.current}}`)
 return services.map(service=>({params:{slug:service.area.slug,service:service.slug},props:{service,related:services.filter(item=>item.area.slug===service.area.slug&&item._id!==service._id)}}))
}
const {service,related}=Astro.props as {service:Service;related:Service[]}
const nav={
 auta:[{label:'Vozy v nabídce',href:'/auta/vozy/'},{label:'Dovoz',href:'/auta/dovoz-vozidel/'},{label:'Prodej',href:'/auta/prodej-vaseho-vozu/'},{label:'Přeprava',href:'/auta/preprava-vozidel/'},{label:'Kontakt',href:'#poptavka'}],
 servis:[{label:'Servis & performance',href:'/servis/servis-a-performance/'},{label:'Suchý led',href:'/servis/suchy-led/'},{label:'Ochrana podvozku',href:'/servis/antikorozni-ochrana-podvozku/'},{label:'Kontakt',href:'#poptavka'}],
 detailing:[{label:'PPF',href:'/detailing/ppf/'},{label:'Wrap',href:'/detailing/wrap-folie/'},{label:'Tónování',href:'/detailing/tonovani-skel/'},{label:'Mytí',href:'/detailing/cisteni-a-myti/'},{label:'Lak',href:'/detailing/lesteni-a-ochrana-laku/'},{label:'Renovace',href:'/detailing/individualni-renovace/'},{label:'Kontakt',href:'#poptavka'}],
}
const images:Record<string,[string,string,string]>={
 'preprava-vozidel':['/media/transport-trailer.jpg','/media/vehicle-audi-rs4-2.jpg','/media/vehicle-jaguar-3.jpg'],
 'dovoz-vozidel':['/media/vehicle-audi-rs4-1.jpg','/media/vehicle-jaguar-1.jpg','/media/vehicle-octavia-2.jpg'],
 'prodej-vaseho-vozu':['/media/vehicle-octavia-1.jpg','/media/vehicle-audi-rs4-3.jpg','/media/vehicle-multivan-2.jpg'],
 'servis-a-performance':['/media/service-cayman.jpg','/media/service-bmw-m2.jpg','/media/service-cayenne.jpg'],
 'suchy-led':['/media/dry-ice-3.jpg','/media/dry-ice-1.jpg','/media/dry-ice-4.jpg'],
 'antikorozni-ochrana-podvozku':['/media/dry-ice-4.jpg','/media/service-cayman.jpg','/media/dry-ice-1.jpg'],
 ppf:['/media/ppf-work.jpg','/media/ppf-film.jpg','/media/alfa-4c-detail.jpg'],
 'wrap-folie':['/media/defender-v8.jpg','/media/ppf-work.jpg','/media/mercedes-gtr.jpg'],
 'tonovani-skel':['/media/bmw-m3c.jpg','/media/aston-vanquish.jpg','/media/volvo-v60.jpg'],
 'cisteni-a-myti':['/media/alfa-4c.jpg','/media/hala.jpg','/media/porsche-pair.jpg'],
 'lesteni-a-ochrana-laku':['/media/gtr-nismo.jpg','/media/amg-yellow.jpg','/media/bmw-m3-touring.jpg'],
 'individualni-renovace':['/media/maserati-merak.jpg','/media/ford-escort.jpg','/media/impreza-prodrive.jpg'],
}
const fallback:Record<string,Step[]>={
 auta:[{title:'Zadání',text:'Ujasníme vůz, rozpočet, termín a vaše priority.'},{title:'Prověření',text:'Otestujeme podklady, historii i technický stav.'},{title:'Realizace',text:'Převezmeme komunikaci, administrativu a logistiku.'},{title:'Předání',text:'Vůz a dokumenty projdeme společně.'}],
 servis:[{title:'Vstupní kontrola',text:'Projdeme stav vozu, historii a příznaky.'},{title:'Návrh práce',text:'Vysvětlíme varianty, cenu a reálný termín.'},{title:'Realizace',text:'Průběh dokumentujeme a změny rozsahu potvrzujeme.'},{title:'Kontrola',text:'Výsledek ověříme před osobním předáním.'}],
 detailing:[{title:'Prohlídka',text:'Povrch zkontrolujeme v odpovídajícím světle.'},{title:'Příprava',text:'Vůz bezpečně umyjeme a dekontaminujeme.'},{title:'Aplikace',text:'Pracujeme v čistém kontrolovaném prostoru.'},{title:'Předání',text:'Vysvětlíme následnou péči a údržbu.'}],
}
const media=images[service.slug]
const steps=service.process?.length?service.process:fallback[service.area.slug]
const isPpf=service.slug==='ppf'
const film=service.slug==='individualni-renovace'?{id:'GmGAPUCy2EU',title:'Renovace Corvette ZR1 — zpět k původnímu lesku'}:null
const tone=service.area.slug==='auta'?'light':'dark'
---
<!doctype html><html lang="cs"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={service.summary}/><title>{service.title} — Mužíček {service.area.title}</title></head><body class={`theme-${service.area.slug}`}>
<MicrositeHeader section={service.area.slug} tone={tone} links={nav[service.area.slug as keyof typeof nav]}/>
<main class="service-page" id="main-content">
 <section class="service-hero"><div class="service-hero__copy"><a href={`/${service.area.slug}/`} class="back"><ArrowIcon direction="left" size={16}/><span>Mužíček {service.area.title}</span></a><p class="kicker">{service.area.title}</p><h1>{service.title}</h1><p>{service.summary}</p><a class="button button--red" href="#poptavka">Nezávazně poptat</a></div><figure><img src={media[0]} alt={service.title} data-parallax/></figure></section>
 <section class="service-intro page-width"><aside><p class="kicker">Co děláme</p><dl><div><dt>Orientační doba</dt><dd>{service.duration||'Podle rozsahu'}</dd></div><div><dt>Nacenění</dt><dd>{service.priceNote||'Po konzultaci'}</dd></div></dl></aside><div><h2>{service.introTitle||service.title}</h2><p>{service.details||service.summary}</p>{service.benefits?.length&&<ul>{service.benefits.map(item=><li>{item}</li>)}</ul>}</div></section>
 <section class="service-evidence"><div class="service-evidence__main"><img src={media[1]} alt={`${service.title} — detail práce`} loading="lazy"/></div><div class="service-evidence__copy"><p class="kicker">Průběh zakázky</p><div class="timeline">{steps.map(step=><article><h3>{step.title}</h3><p>{step.text}</p></article>)}</div></div><div class="service-evidence__detail"><img src={media[2]} alt={`${service.title} — výsledek`} loading="lazy"/></div></section>
 {isPpf&&<section class="ppf-film" aria-labelledby="ppf-film-title">
   <div class="ppf-film__copy">
    <p class="kicker">Skutečná práce v dílně</p>
    <h2 id="ppf-film-title">Fólie drží tak dobře, jak dobře je připravený povrch.</h2>
    <p>Na záběrech je ruční aplikace ochranné fólie na připravený díl. Před samotnou instalací lak bezpečně vyčistíme, zkontrolujeme pod pracovním světlem a fólii usazujeme po jednotlivých částech. Hrany a napojení kontrolujeme ještě před předáním vozu.</p>
    <dl>
     <div><dd>Příprava a kontrola laku</dd></div>
     <div><dd>Přesná aplikace po dílech</dd></div>
     <div><dd>Kontrola hran a výsledku</dd></div>
    </dl>
   </div>
   <figure>
    <video autoplay muted loop playsinline preload="metadata" poster="/media/ppf-work.jpg" aria-label="Ruční aplikace PPF fólie v dílně Mužíček">
     <source src="/media/muzicek-detailing-process.mp4" type="video/mp4"/>
    </video>
    <figcaption>Aplikace PPF v dílně Mužíček, Jablonec nad Nisou</figcaption>
   </figure>
  </section>}
 {film&&<FilmChapter videoId={film.id} title={film.title} image={media[1]} caption="Skutečná realizace Mužíček"/>}
 {related.length>0&&<nav class="related page-width" aria-label="Další služby"><p class="kicker">Další v této části</p><div>{related.map(item=><a href={`/${item.area.slug}/${item.slug}/`}><span>{item.title}</span><small>{item.summary}</small><b><ArrowIcon /></b></a>)}</div></nav>}
 <section class="inquiry-section" id="poptavka"><div class="page-width"><header><p class="kicker">Nezávazná poptávka</p><h2>Nejdřív se podíváme na vůz. Pak doporučíme další krok.</h2></header><InquiryForm area={service.area.slug} service={service.title}/></div></section>
</main><SiteFooter section={service.area.title}/><MotionDirector/><VisualEditing enabled={import.meta.env.DEV}/></body></html>
<style>
  .service-page{padding-top:92px;background:var(--paper);color:var(--ink)}.service-hero{min-height:clamp(660px,80svh,820px);display:grid;grid-template-columns:minmax(400px,.84fr) minmax(0,1.16fr);background:#e7e4dc}.service-hero__copy{display:flex;flex-direction:column;justify-content:flex-end;padding:105px clamp(28px,5vw,76px) 58px}.back{position:absolute;top:126px;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.service-hero h1{max-width:660px;margin:20px 0 25px;font-size:clamp(50px,5.8vw,88px);line-height:.9;letter-spacing:-.05em}.service-hero__copy>p:not(.kicker){max-width:540px;margin:0 0 28px;font-size:16px;line-height:1.65}.service-hero .button{align-self:flex-start}.service-hero figure{margin:0;overflow:hidden}.service-hero figure img{width:100%;height:100%;object-fit:cover;object-position:center 55%}.service-intro{display:grid;grid-template-columns:.55fr 1.45fr;gap:clamp(55px,9vw,140px);padding-block:105px}.service-intro aside dl{margin:30px 0 0}.service-intro aside dl div{padding:15px 0;border-top:1px solid #aaa}.service-intro dt{color:#777;font-size:10px;text-transform:uppercase;letter-spacing:.1em}.service-intro dd{margin:7px 0 0;font-size:13px;line-height:1.5}.service-intro h2{max-width:820px;margin:0;font-size:clamp(41px,4.8vw,70px);line-height:.96;letter-spacing:-.04em}.service-intro>div>p{max-width:760px;margin:28px 0 38px;font-size:18px;line-height:1.65}.service-intro ul{display:grid;grid-template-columns:1fr 1fr;margin:0;padding:0;list-style:none;border-top:1px solid #aaa}.service-intro li{padding:15px 0;border-bottom:1px solid #aaa}.service-intro li:nth-child(odd){padding-right:18px}.service-intro li:nth-child(even){padding-left:18px;border-left:1px solid #aaa}.service-evidence{display:grid;grid-template-columns:1.05fr .72fr .48fr;min-height:650px;max-height:760px;background:#0b0b0b;color:#fff}.service-evidence img{width:100%;height:100%;object-fit:cover;object-position:center}.service-evidence__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(34px,4.5vw,68px)}.timeline{margin-top:30px}.timeline article{position:relative;padding:0 0 22px 22px;border-left:1px solid #555}.timeline article::before{content:'';position:absolute;left:-4px;top:3px;width:7px;height:7px;background:var(--red)}.timeline h3{margin:0 0 7px;font-size:19px}.timeline p{margin:0;color:#aaa;font-size:13px;line-height:1.55}.service-evidence__detail{min-height:330px}.ppf-film{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(300px,.58fr);gap:clamp(50px,8vw,125px);align-items:center;padding:110px clamp(22px,7vw,105px);background:#ece8df}.ppf-film__copy{max-width:820px}.ppf-film h2{max-width:780px;margin:20px 0 28px;font-family:var(--serif);font-size:clamp(42px,5.2vw,76px);font-weight:400;line-height:.95;letter-spacing:-.04em}.ppf-film__copy>p:last-of-type{max-width:680px;font-size:17px;line-height:1.68;color:#48443f}.ppf-film dl{margin:46px 0 0;border-top:1px solid #aaa}.ppf-film dl div{padding:16px 0;border-bottom:1px solid #aaa}.ppf-film dd{margin:0;font-size:14px}.ppf-film figure{margin:0}.ppf-film video{display:block;width:100%;max-height:680px;aspect-ratio:9/16;object-fit:cover;background:#151515}.ppf-film figcaption{margin-top:12px;color:#68635d;font-size:10px;letter-spacing:.08em;text-transform:uppercase}.related{padding-block:100px}.related>div{margin-top:32px;border-top:1px solid #aaa}.related a{display:grid;grid-template-columns:.7fr 1.2fr 40px;gap:32px;align-items:start;padding:21px 0;border-bottom:1px solid #aaa}.related span{font-size:clamp(24px,2.5vw,36px);line-height:1}.related small{color:#666;line-height:1.55}.related b{color:var(--red);font-size:20px;text-align:right}.inquiry-section{padding:105px 0;background:#dcd8cf}.inquiry-section>.page-width{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(55px,8vw,125px)}.inquiry-section h2{margin:18px 0 0;font-size:clamp(38px,4.6vw,64px);line-height:.97;letter-spacing:-.04em}
  :global(.theme-servis) .service-page{background:#101010;color:#fff}:global(.theme-servis) .service-hero{background:#101010;color:#fff}:global(.theme-servis) .service-hero figure img{filter:saturate(.7)}:global(.theme-servis) .service-intro aside dl div,:global(.theme-servis) .service-intro ul,:global(.theme-servis) .service-intro li{border-color:#444}:global(.theme-servis) .service-intro dt,:global(.theme-servis) .related small{color:#999}:global(.theme-servis) .related>div,:global(.theme-servis) .related a{border-color:#444}:global(.theme-servis) .inquiry-section{background:#1b1b1b}:global(.theme-detailing) .service-hero{grid-template-columns:.9fr 1.1fr;background:#ddd8cd}:global(.theme-detailing) .service-hero figure{margin:55px 55px 55px 0}:global(.theme-detailing) .service-evidence{grid-template-columns:.55fr .75fr .7fr;background:#d2cdc3;color:#0a0a0a}:global(.theme-detailing) .timeline p{color:#555}:global(.theme-detailing) .inquiry-section{background:#ccc6ba}
  .service-evidence__main,.service-evidence__detail{overflow:hidden}
  @media(max-width:900px){.service-hero,.service-intro,.inquiry-section>.page-width,.ppf-film{grid-template-columns:1fr}.service-hero__copy{min-height:540px}.service-hero figure{min-height:54vw}:global(.theme-detailing) .service-hero figure{margin:0}.service-evidence{grid-template-columns:1fr 1fr;max-height:none}.service-evidence__main{grid-column:1/-1;min-height:58vw}.ppf-film figure{max-width:520px}.related a{grid-template-columns:1fr 30px}.related small{grid-column:1}.inquiry-section>.page-width{gap:55px}}@media(max-width:600px){.service-page{padding-top:76px}.back{top:102px}.service-hero__copy{padding:100px 18px 42px}.service-intro{padding-block:78px}.service-intro ul{grid-template-columns:1fr}.service-intro li:nth-child(even){padding-left:0;border-left:0}.service-evidence{grid-template-columns:1fr}.service-evidence__copy{padding:64px 18px}.service-evidence__detail{min-height:74vw}.ppf-film{padding:78px 18px}.ppf-film dl{margin-top:38px}.related,.inquiry-section{padding-block:78px}}
  .back{display:flex;align-items:center;gap:8px}.related b{display:grid;place-items:center}
</style>
