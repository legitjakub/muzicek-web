---
import Base from '../../layouts/Base.astro'
import Hero from '../../components/Hero.astro'
import Img from '../../components/Img.astro'
import FilmChapter from '../../components/FilmChapter.astro'
import InquiryForm from '../../components/InquiryForm.astro'
import {u} from '../../lib/url'
import {getContent, type Service} from '../../lib/content'
import {worldByKey, type WorldKey} from '../../data/site'

export async function getStaticPaths() {
  const {services} = await getContent()
  return services.map((service) => ({params: {slug: service.area, service: service.slug}, props: {service, related: services.filter((s) => s.area === service.area && s.slug !== service.slug)}}))
}
const {service, related} = Astro.props as {service: Service; related: Service[]}
const world = service.area as WorldKey
const w = worldByKey[world]

type M = {hero: string; heroPos?: string; mid: string; midPos?: string; detail: string; alt: string[]}
const media: Record<string, M> = {
  'preprava-vozidel': {hero: 'van-trailer', mid: 'van-field', detail: 'jaguar-3', alt: ['Dodávka s krytým přívěsem Mužíček před provozovnou', 'Dodávka s přívěsem na louce', 'Jaguar XJ Sovereign připravený k přepravě']},
  'dovoz-vozidel': {hero: 'rs4-4', heroPos: '50% 60%', mid: 'jaguar-6', detail: 'multivan-3', alt: ['Audi RS4 Avant v hale Mužíček', 'Jaguar XJ Sovereign po převzetí', 'Volkswagen Multivan po převzetí']},
  'prodej-vaseho-vozu': {hero: 'octavia-1', heroPos: '50% 62%', mid: 'rs4-3', detail: 'multivan-2', alt: ['Škoda Octavia RS připravená k prodeji', 'Audi RS4 Avant profesionálně nafocené', 'Volkswagen Multivan v showroomu']},
  'servis-a-performance': {hero: 'cayman-wing', heroPos: '50% 45%', mid: 'm2-rear', detail: 'cayenne-exhaust', alt: ['Karbonové křídlo Porsche Cayman GT4', 'BMW M2 v hale Mužíček', 'Výfukové koncovky Porsche Cayenne']},
  'suchy-led': {hero: 'dry-ice-3', heroPos: '50% 40%', mid: 'dry-ice-1', detail: 'dry-ice-4', alt: ['Čištění podvozku suchým ledem', 'Čištění motorového prostoru suchým ledem', 'Tryskání podvozku suchým ledem v oblaku páry']},
  'antikorozni-ochrana-podvozku': {hero: 'octavia-13', heroPos: '50% 55%', mid: 'dry-ice-4', detail: 'octavia-15', alt: ['Podvozek vozu na zvedáku', 'Čištění podvozku před konzervací', 'Spodek vozu a zavěšení']},
  ppf: {hero: 'ppf-door', heroPos: '50% 45%', mid: 'ppf-m3', detail: 'alfa-detail', alt: ['Ruční aplikace ochranné fólie', 'Aplikace PPF na přední část BMW M3', 'Lak Alfa Romeo 4C v bočním světle']},
  'wrap-folie': {hero: 'film-door', mid: 'defender', midPos: '50% 40%', detail: 'mercedes-gtr', alt: ['Barevná fólie na dveřích vozu', 'Land Rover Defender V8 s polepem', 'Mercedes-AMG GT R po polepu']},
  'tonovani-skel': {hero: 'tint-1', mid: 'tint-3', detail: 'volvo', alt: ['Aplikace tónovací fólie na okno', 'Tónovací fólie při montáži', 'Volvo V60 v hale Mužíček']},
  'cisteni-a-myti': {hero: 'alfa-4c', heroPos: '50% 60%', mid: 'hala', detail: 'porsche-cabin', alt: ['Alfa Romeo 4C po ručním mytí', 'Hala Mužíček s vozy', 'Interiér Porsche po čištění']},
  'lesteni-a-ochrana-laku': {hero: 'gtr-nismo', heroPos: '50% 55%', mid: 'amg-gt-yellow', detail: 'm3-grille', alt: ['Nissan GT-R Nismo po úpravě laku', 'Mercedes-AMG GT ve žlutém laku', 'BMW M3 po úpravě a ochraně laku']},
  'individualni-renovace': {hero: 'merak', heroPos: '50% 60%', mid: 'escort', detail: 'impreza', alt: ['Interiér Maserati Merak', 'Ford Escort v hale Mužíček', 'Subaru Impreza Prodrive']},
}
const m = media[service.slug]
const fallback: Record<string, {title: string; text: string}[]> = {
  auta: [{title: 'Zadání', text: 'Ujasníme vůz, rozpočet, termín a vaše priority.'}, {title: 'Prověření', text: 'Ověříme podklady, historii i technický stav.'}, {title: 'Realizace', text: 'Převezmeme komunikaci, administrativu a logistiku.'}, {title: 'Předání', text: 'Vůz a dokumenty projdeme společně.'}],
  servis: [{title: 'Vstupní kontrola', text: 'Projdeme stav vozu, historii a příznaky.'}, {title: 'Návrh práce', text: 'Vysvětlíme varianty, cenu a reálný termín.'}, {title: 'Realizace', text: 'Průběh dokumentujeme a změny rozsahu potvrzujeme.'}, {title: 'Kontrola', text: 'Výsledek ověříme před osobním předáním.'}],
  detailing: [{title: 'Prohlídka', text: 'Povrch zkontrolujeme v odpovídajícím světle.'}, {title: 'Příprava', text: 'Vůz bezpečně umyjeme a dekontaminujeme.'}, {title: 'Aplikace', text: 'Pracujeme v čistém kontrolovaném prostoru.'}, {title: 'Předání', text: 'Vysvětlíme následnou péči a údržbu.'}],
}
const steps = service.process?.length ? service.process : fallback[world]
const crossRs6 = ['ppf', 'lesteni-a-ochrana-laku', 'tonovani-skel'].includes(service.slug)
const facts = [{k: 'Orientační doba', v: service.duration ?? 'Podle rozsahu'}, {k: 'Nacenění', v: service.priceNote ?? 'Po konzultaci'}]
const isCars = world === 'auta'
---
<Base
  world={world}
  title={`${service.title} — Mužíček ${w.label}`}
  description={service.summary}
  image={m.hero}
  jsonld={[{'@context': 'https://schema.org', '@type': 'Service', name: service.title, description: service.details ?? service.summary, provider: {'@type': 'AutomotiveBusiness', name: 'Mužíček'}, areaServed: 'CZ'}]}
>
  <link slot="head" rel="preload" as="image" href={u(`/img/${m.hero}-1600.webp`)} imagesrcset={`${u(`/img/${m.hero}-800.webp`)} 800w, ${u(`/img/${m.hero}-1600.webp`)} 1600w`} imagesizes="100vw" fetchpriority="high" />

  <Hero
    world={world} num={w.num} kicker={`${w.label} · ${service.title}`} image={m.hero} pos={m.heroPos} alt={m.alt[0]}
    title={[service.title]} compact
    lede={service.summary}
    actions={[{label: 'Nezávazně poptat', href: '#poptavka'}, {label: `Zpět na ${w.label}`, href: w.href}]}
    facts={facts}
  />

  <section class="intro wrap" aria-labelledby="intro-title">
    <p class="label intro__label" data-reveal="fade">Co děláme</p>
    <div class="intro__main">
      <h2 id="intro-title" class:list={['intro__title', isCars ? 'serif' : 'display']} data-split>{service.introTitle ?? service.title}</h2>
      <p class="intro__lede" data-reveal="up">{service.details ?? service.summary}</p>
    </div>
    {service.benefits?.length && (
      <ol class="benefits" data-stagger>
        {service.benefits.map((b, i) => <li><span class="num">0{i + 1}</span><span>{b}</span></li>)}
      </ol>
    )}
  </section>

  <section class="bleed" aria-label="Fotografie z práce">
    <div class="bleed__img frame" data-parallax-host data-reveal="mask"><Img id={m.mid} class="cover" data-parallax="0.1" alt={m.alt[1]} pos={m.midPos} sizes="100vw" /></div>
  </section>

  <section class="process wrap" aria-labelledby="process-title">
    <header>
      <p class="label" data-reveal="fade">Průběh zakázky</p>
      <h2 id="process-title" class:list={['t-l', isCars ? 'serif' : 'display']} data-split>Jak to probíhá.</h2>
    </header>
    <ol class="steps" data-progress>
      {steps.map((s, i) => (
        <li class="step" style={`--i:${i}`}>
          <span class="step__n num" aria-hidden="true">0{i + 1}</span>
          <h3 class="step__t">{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  {service.slug === 'ppf' && (
    <section class="vid wrap" aria-labelledby="vid-title">
      <div class="vid__copy">
        <p class="label">Skutečná práce v dílně</p>
        <h2 id="vid-title" class="display t-l" data-split>Fólie drží tak dobře, jak dobře je připravený povrch.</h2>
        <p class="lede mute">Před instalací lak bezpečně vyčistíme, zkontrolujeme pod pracovním světlem a fólii usazujeme po jednotlivých částech. Hrany a napojení kontrolujeme ještě před předáním vozu.</p>
      </div>
      <figure class="vid__frame frame"><video muted loop playsinline preload="none" poster={u('/img/ppf-m3-800.webp')} aria-label="Ruční aplikace PPF fólie v dílně Mužíček" data-lazyvideo><source src={u('/media/process-960.mp4')} type="video/mp4" /></video><figcaption class="cap">Aplikace PPF v dílně Mužíček</figcaption></figure>
    </section>
  )}

  <section class="duo" aria-label="Další fotografie">
    <figure class="duo__a frame" data-reveal="mask-x" data-parallax-host><Img id={m.detail} class="cover" data-parallax="0.08" alt={m.alt[2]} sizes="(min-width: 900px) 50vw, 100vw" /></figure>
    {crossRs6 ? (
      <a class="duo__b" href={u('/realizace/audi-rs6/')} data-reveal="up">
        <span class="label">Realizace</span>
        <span class="display t-m">Audi RS6 Avant — PPF full polep, keramika, renovace laku</span>
        <span class="link">Příběh realizace</span>
      </a>
    ) : (
      <div class="duo__b" data-reveal="up"><span class="label">Mužíček {w.label}</span><span class="display t-m">{w.statement}</span></div>
    )}
  </section>

  {service.slug === 'individualni-renovace' && <FilmChapter videoId="GmGAPUCy2EU" kicker="Individuální renovace" title="Corvette ZR1 — zpět k původnímu lesku" />}

  {related.length > 0 && (
    <nav class="related wrap" aria-label="Další služby">
      <p class="label">Další v části {w.label}</p>
      <div class="related__list">
        {related.map((r) => <a href={u(`/${r.area}/${r.slug}/`)}><span class="display t-m">{r.title}</span><span class="related__s">{r.summary}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a>)}
      </div>
    </nav>
  )}

  <section class="contact wrap" id="poptavka" aria-labelledby="contact-title">
    <header>
      <p class="label">Nezávazná poptávka</p>
      <h2 id="contact-title" class:list={['t-l', isCars ? 'serif' : 'display']}>Nejdřív se podíváme na vůz. Pak doporučíme další krok.</h2>
    </header>
    <InquiryForm area={world} service={service.title} />
  </section>

  <script>
    const video = document.querySelector<HTMLVideoElement>('[data-lazyvideo]')
    if (video) {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) video.controls = true
      else new IntersectionObserver((entries) => { for (const e of entries) { if (e.isIntersecting) { video.preload = 'auto'; video.play().catch(() => {}) } else video.pause() } }, {threshold: 0.35}).observe(video)
    }
  </script>
</Base>

<style>
  .intro { display: grid; gap: 40px; padding-block: clamp(90px, 13vw, 200px); }
  .intro__label { color: var(--mute); }
  .intro__main { display: grid; gap: 30px; }
  .intro__title { font-size: clamp(44px, 7.4vw, 136px); max-width: 15ch; }
  .intro__title.serif { line-height: .95; letter-spacing: -.03em; }
  .intro__lede { max-width: 52ch; font-size: clamp(18px, 1.6vw, 24px); line-height: 1.5; }
  .benefits { display: grid; border-top: 1px solid var(--line); }
  .benefits li { display: grid; grid-template-columns: 56px 1fr; align-items: baseline; padding: 20px 0; border-bottom: 1px solid var(--line); font: 600 clamp(20px, 2vw, 30px)/1.15 var(--f-display); letter-spacing: .04em; text-transform: uppercase; }
  .benefits .num { color: var(--red); font-size: 15px; letter-spacing: .1em; }
  :global([data-world='auta']) .benefits li { font: 400 clamp(24px, 2.4vw, 38px)/1.1 var(--f-serif); letter-spacing: -.01em; text-transform: none; }
  @media (min-width: 900px) {
    .intro { grid-template-columns: 12ch 1fr; gap: 0 4vw; }
    .intro__main { grid-column: 2; }
    .benefits { grid-column: 2; grid-template-columns: 1fr 1fr; gap: 0 3vw; margin-top: 30px; }
  }

  .bleed__img { height: min(92svh, 920px); min-height: 420px; }

  .process { display: grid; gap: 50px; padding-block: clamp(90px, 13vw, 200px); }
  .process header { display: grid; gap: 14px; }
  .steps { position: relative; display: grid; }
  .step { display: grid; gap: 8px; padding: 26px 0 30px; border-top: 1px solid var(--line); }
  .step__n { font: 600 15px var(--f-display); letter-spacing: .14em; color: var(--red); }
  .step__t { font: 600 clamp(28px, 3vw, 48px)/1 var(--f-display); text-transform: uppercase; }
  :global([data-world='auta']) .step__t { font: 400 clamp(32px, 3.4vw, 54px)/1 var(--f-serif); text-transform: none; }
  .step p { max-width: 30ch; color: var(--mute); }
  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(4, 1fr); gap: 0 clamp(20px, 3vw, 50px); }
    .step { padding-top: 40px; border-top: 2px solid var(--line); }
    :global(.js:not(.rm)) .step { border-color: color-mix(in srgb, var(--red) calc(clamp(0, (var(--p, 0) - .1 - var(--i) * .14) * 6, 1) * 100%), var(--line)); }
    :global(.js:not(.rm)) .step { opacity: calc(.28 + clamp(0, (var(--p, 0) - .1 - var(--i) * .14) * 6, 1) * .72); }
  }

  .vid { display: grid; gap: 40px; padding-block: 0 clamp(90px, 12vw, 180px); align-items: center; }
  .vid__copy { display: grid; gap: 24px; }
  .vid__frame { width: min(100%, 380px); aspect-ratio: 9 / 16; overflow: visible; }
  .vid__frame video { width: 100%; height: 100%; object-fit: cover; background: #111; }
  .vid__frame .cap { position: absolute; top: 100%; }
  @media (min-width: 900px) { .vid { grid-template-columns: 1fr 380px; gap: 8vw; } .vid__frame { justify-self: end; } }

  .duo { display: grid; }
  .duo__a { aspect-ratio: 4 / 3; }
  .duo__b { display: grid; gap: 22px; align-content: center; justify-items: start; padding: 50px var(--gutter); background: var(--fg); color: var(--bg); }
  .duo__b .t-m { max-width: 18ch; }
  @media (min-width: 900px) { .duo { grid-template-columns: 1.2fr .8fr; min-height: 80svh; } .duo__a { aspect-ratio: auto; } .duo__b { padding: 5vw; } }

  .related { display: grid; gap: 24px; padding-block: clamp(80px, 11vw, 170px) 0; }
  .related__list { border-top: 1px solid var(--line); }
  .related a { display: grid; grid-template-columns: 1fr 28px; gap: 6px 20px; align-items: center; padding: 22px 0; border-bottom: 1px solid var(--line); transition: padding .5s var(--ease); }
  .related a:hover { padding-left: 14px; }
  .related__s { grid-column: 1; color: var(--mute); max-width: 60ch; }
  .related svg { grid-row: 1 / 3; grid-column: 2; width: 28px; color: var(--red); }
  @media (min-width: 900px) { .related a { grid-template-columns: .9fr 1fr 40px; } .related__s { grid-column: 2; } .related svg { grid-row: 1; grid-column: 3; } }

  .contact { display: grid; gap: 50px; padding-block: clamp(90px, 13vw, 200px); }
  .contact header { display: grid; gap: 16px; align-content: start; }
  .contact h2 { max-width: 14ch; }
  @media (min-width: 900px) { .contact { grid-template-columns: .95fr 1.05fr; gap: 8vw; } }
</style>
