---
import {VisualEditing} from '@sanity/astro/visual-editing'
import {sanity} from '../../../lib/sanity'
import '../../../styles/site.css'
import MicrositeHeader from '../../../components/MicrositeHeader.astro'
import SiteFooter from '../../../components/SiteFooter.astro'
import ArrowIcon from '../../../components/ArrowIcon.astro'
import MotionDirector from '../../../components/MotionDirector.astro'
import {vehicleImageFor, vehiclePrice, vehicleStatusLabel, vehicleSubtitle} from '../../../lib/vehicleDisplay'

type Vehicle={title:string;slug:string;subtitle?:string;price?:number;year?:number;mileage?:number;fuel?:string;transmission?:string;drivetrain?:string;power?:string;engine?:string;vin?:string;inspection?:string;vatDeductible?:boolean;status:string;cover:string;gallery:string[];description?:string;equipment?:string[]}
export async function getStaticPaths(){
  const vehicles=await sanity.fetch<Vehicle[]>(`*[_type=="vehicle"]{title,"slug":slug.current,subtitle,price,year,mileage,fuel,transmission,drivetrain,power,engine,vin,inspection,vatDeductible,status,"cover":coverImage.asset->url,"gallery":gallery[].asset->url,"description":pt::text(description),equipment}`)
  return vehicles.map(vehicle=>({params:{vehicle:vehicle.slug},props:{vehicle}}))
}
const {vehicle}=Astro.props as {vehicle:Vehicle}
const links=[{label:'Všechny vozy',href:'/auta/vozy/'},{label:'Dovoz',href:'/auta/dovoz-vozidel/'},{label:'Prodej',href:'/auta/prodej-vaseho-vozu/'},{label:'Přeprava',href:'/auta/preprava-vozidel/'},{label:'Kontakt',href:'#kontakt'}]
const facts=[['Rok',vehicle.year],['Nájezd',vehicle.mileage?`${new Intl.NumberFormat('cs-CZ').format(vehicle.mileage)} km`:null],['Palivo',vehicle.fuel],['Převodovka',vehicle.transmission],['Pohon',vehicle.drivetrain],['Výkon',vehicle.power],['Motor',vehicle.engine],['STK',vehicle.inspection]].filter(([,value])=>value)
---
<!doctype html><html lang="cs"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={vehicle.description}/><title>{vehicle.title} — Mužíček Auta</title></head><body>
<MicrositeHeader section="auta" tone="light" links={links}/>
<main class="vehicle-detail" id="main-content"><section class="vehicle-hero"><div class="vehicle-hero__copy"><a class="back" href="/auta/vozy/"><ArrowIcon direction="left" size={16}/><span>Nabídka vozů</span></a><p class="kicker">{vehicleStatusLabel(vehicle.status)}</p><h1>{vehicle.title}</h1><p>{vehicleSubtitle(vehicle.subtitle)}</p><strong>{vehiclePrice(vehicle.price)}</strong>{vehicle.vatDeductible&&<small>Možnost odpočtu DPH</small>}</div><div class="vehicle-hero__image"><img src={vehicleImageFor(vehicle)} alt={vehicle.title} data-parallax/></div></section>
<section class="vehicle-data page-width"><div class="vehicle-data__story"><p class="kicker">O voze</p><p>{vehicle.description}</p><a class="button button--red" href={`mailto:info@muzicek.com?subject=${encodeURIComponent(`Poptávka: ${vehicle.title}`)}`}>Mám zájem o vůz</a></div><dl>{facts.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>
{vehicle.gallery?.length>0&&<section class="vehicle-gallery">{vehicle.gallery.map((image,index)=><img src={image} alt={`${vehicle.title} — fotografie ${index+2}`} loading="lazy"/>)}</section>}
{vehicle.equipment?.length&&<section class="vehicle-equipment page-width"><p class="kicker">Důležité informace</p><ul>{vehicle.equipment.map(item=><li>{item}</li>)}</ul></section>}
<section class="vehicle-contact" id="kontakt"><div class="page-width"><p class="kicker">Prohlídka vozu</p><h2>Domluvte si konkrétní termín.</h2><div><a class="button button--red" href={`mailto:info@muzicek.com?subject=${encodeURIComponent(`Prohlídka: ${vehicle.title}`)}`}>Napsat</a><a class="button" href="tel:+420775911005">+420 775 911 005</a></div></div></section></main>
<SiteFooter section="Auta"/><MotionDirector/><VisualEditing enabled={import.meta.env.DEV}/></body></html>
<style>
  .vehicle-detail{padding-top:92px;background:#f3f2ed}.vehicle-hero{min-height:calc(100svh - 92px);display:grid;grid-template-columns:.72fr 1.28fr;background:#e6e3dc}.vehicle-hero__copy{display:flex;flex-direction:column;justify-content:flex-end;padding:110px clamp(28px,5vw,80px) 70px}.back{position:absolute;top:130px;font-size:10px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.vehicle-hero h1{margin:22px 0 14px;font-size:clamp(54px,7vw,105px);line-height:.86;letter-spacing:-.06em}.vehicle-hero__copy>p:not(.kicker){font-size:17px}.vehicle-hero strong{margin-top:48px;font-size:25px}.vehicle-hero small{margin-top:8px;color:#65645f}.vehicle-hero__image img{width:100%;height:100%;object-fit:cover}.vehicle-data{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(55px,10vw,160px);padding-block:140px}.vehicle-data__story>p:not(.kicker){max-width:570px;margin:25px 0 42px;font-size:22px;line-height:1.55}.vehicle-data dl{margin:0;border-top:1px solid #aaa}.vehicle-data dl div{display:grid;grid-template-columns:1fr 1fr;gap:20px;padding:18px 0;border-bottom:1px solid #aaa}.vehicle-data dt{color:#777;font-size:11px;text-transform:uppercase;letter-spacing:.1em}.vehicle-data dd{margin:0;text-align:right;font-weight:700}.vehicle-gallery{display:grid;grid-template-columns:1.35fr .65fr;grid-template-rows:1fr 1fr;min-height:900px}.vehicle-gallery img{width:100%;height:100%;object-fit:cover}.vehicle-gallery img:first-child{grid-row:1/-1}.vehicle-equipment{display:grid;grid-template-columns:.65fr 1.35fr;gap:50px;padding-block:130px}.vehicle-equipment ul{margin:0;padding:0;list-style:none;border-top:1px solid #aaa}.vehicle-equipment li{padding:18px 0;border-bottom:1px solid #aaa;font-size:18px}.vehicle-contact{padding:130px 0;background:#d9d5ca}.vehicle-contact h2{margin:20px 0 42px;font-size:clamp(52px,7vw,105px);line-height:.9;letter-spacing:-.055em}.vehicle-contact .button{margin:0 8px 8px 0}.vehicle-contact .button:not(.button--red){color:#111}
  @media(max-width:800px){.vehicle-detail{padding-top:76px}.vehicle-hero{grid-template-columns:1fr}.vehicle-hero__copy{min-height:570px}.vehicle-hero__image{min-height:65vw}.back{top:105px}.vehicle-data,.vehicle-equipment{grid-template-columns:1fr}.vehicle-gallery{min-height:650px}}@media(max-width:520px){.vehicle-hero__copy{padding:100px 18px 48px}.vehicle-data{padding-block:90px}.vehicle-gallery{min-height:560px;grid-template-columns:1fr 1fr;grid-template-rows:1.3fr .7fr}.vehicle-gallery img:first-child{grid-column:1/-1;grid-row:auto}.vehicle-equipment{padding-block:90px}}
  .back{display:flex;align-items:center;gap:8px}
  .vehicle-hero__image{overflow:hidden}
  .vehicle-detail,.vehicle-gallery{overflow:clip}
</style>
