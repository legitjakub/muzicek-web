---
import Base from '../../../layouts/Base.astro'
import Hero from '../../../components/Hero.astro'
import Img from '../../../components/Img.astro'
import InquiryForm from '../../../components/InquiryForm.astro'
import {u} from '../../../lib/url'
import {getContent, czk, km, statusLabel, type Vehicle} from '../../../lib/content'
import {vehicleMedia, coverFor} from '../../../data/vehicleMedia'

export async function getStaticPaths() {
  const {vehicles} = await getContent()
  return vehicles.map((v, i) => ({params: {vehicle: v.slug}, props: {vehicle: v, next: vehicles[(i + 1) % vehicles.length]}}))
}
const {vehicle, next} = Astro.props as {vehicle: Vehicle; next: Vehicle}
const media = vehicleMedia[vehicle.slug]
const hero = media?.hero ?? 'rs4-1'
const specs = [
  ['Rok', vehicle.year], ['Nájezd', km(vehicle.mileage)], ['Výkon', vehicle.power], ['Motor', vehicle.engine],
  ['Převodovka', vehicle.transmission], ['Palivo', vehicle.fuel], ['Pohon', vehicle.drivetrain], ['STK', vehicle.inspection],
].filter(([, v]) => v) as [string, string | number][]
const subject = encodeURIComponent(`Poptávka: ${vehicle.title}`)
const facts = [{k: 'Cena', v: czk(vehicle.price) + (vehicle.vatDeductible ? ' · možnost odpočtu DPH' : '')}, {k: 'Stav', v: statusLabel(vehicle.status)}]
---
<Base
  world="auta"
  title={`${vehicle.title} — Mužíček Auta`}
  description={vehicle.description ?? vehicle.subtitle ?? vehicle.title}
  image={hero}
  jsonld={[{
    '@context': 'https://schema.org', '@type': 'Car', name: vehicle.title, description: vehicle.description, vehicleModelDate: vehicle.year ? String(vehicle.year) : undefined,
    mileageFromOdometer: vehicle.mileage != null ? {'@type': 'QuantitativeValue', value: vehicle.mileage, unitCode: 'KMT'} : undefined,
    fuelType: vehicle.fuel, vehicleTransmission: vehicle.transmission,
    offers: vehicle.price ? {'@type': 'Offer', price: vehicle.price, priceCurrency: 'CZK', availability: vehicle.status === 'available' ? 'https://schema.org/InStock' : 'https://schema.org/SoldOut'} : undefined,
  }]}
>
  <link slot="head" rel="preload" as="image" href={u(`/img/${hero}-1600.webp`)} imagesrcset={`${u(`/img/${hero}-800.webp`)} 800w, ${u(`/img/${hero}-1600.webp`)} 1600w`} imagesizes="100vw" fetchpriority="high" />

  <Hero world="auta" num="01" kicker="Auta · Nabídka vozů" image={hero} pos={media?.heroPos} alt={`${vehicle.title} v showroomu Mužíček`} title={[vehicle.title]} compact
    lede={vehicle.subtitle?.replaceAll(' · ', ', ')} facts={facts}
    actions={[{label: 'Mám zájem o vůz', href: '#poptavka'}, {label: 'Zpět do nabídky', href: '/auta/vozy/'}]} />

  <section class="specs wrap" aria-label="Technické údaje">
    <dl class="specs__grid" data-stagger>
      {specs.map(([k, v]) => <div><dt>{k}</dt><dd class="display num">{v}</dd></div>)}
    </dl>
  </section>

  {vehicle.description && (
    <section class="story wrap" aria-label="O voze">
      <p class="label" data-reveal="fade">O voze</p>
      <p class="serif story__text" data-wordscrub>{vehicle.description}</p>
    </section>
  )}

  {media?.chapters.map((c) => (
    <section class="chapter" aria-labelledby={`ch-${c.title}`}>
      <header class="chapter__head wrap"><p class="label" data-reveal="fade">Fotografie</p><h2 class="serif t-l" id={`ch-${c.title}`} data-split>{c.title}</h2></header>
      <div class="gallery">
        {c.shots.map((s, i) => (
          <figure class:list={['shot', `s${i % 5}`]} data-reveal="mask" data-parallax-host>
            <Img id={s.id} class="cover" data-parallax="0.06" alt={s.alt} sizes="(min-width: 900px) 60vw, 100vw" />
          </figure>
        ))}
      </div>
    </section>
  ))}

  {vehicle.equipment?.length && (
    <section class="equip wrap" aria-labelledby="equip-title">
      <header><p class="label" data-reveal="fade">Důležité informace</p><h2 id="equip-title" class="serif t-l" data-split>Výbava a stav.</h2></header>
      <ul class="equip__list" data-stagger>{vehicle.equipment.map((e) => <li>{e}</li>)}</ul>
    </section>
  )}

  <a class="next" href={u(`/auta/vozy/${next.slug}/`)}>
    <span class="next__img frame"><Img id={coverFor(next.slug) ?? 'rs4-1'} class="cover" alt="" sizes="(min-width: 900px) 50vw, 100vw" /></span>
    <span class="next__copy wrap"><span class="label">Další vůz</span><span class="serif t-l">{next.title}</span><span class="link">Zobrazit</span></span>
  </a>

  <section class="contact wrap" id="poptavka" aria-labelledby="contact-title">
    <header>
      <p class="label">Prohlídka vozu</p>
      <h2 id="contact-title" class="serif t-xl">Domluvte si termín.</h2>
      <p class="mute">Napište, nebo zavolejte — prohlídku vozu domluvíme na konkrétní den. <a class="link" href={`mailto:info@muzicek.com?subject=${subject}`}>Napsat e-mail</a></p>
    </header>
    <InquiryForm area="auta" car={vehicle.title} />
  </section>
</Base>

<style>
  .specs { padding-block: clamp(70px, 10vw, 150px); }
  .specs__grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  .specs__grid div { display: grid; gap: 6px; padding: 22px 12px 24px 0; border-bottom: 1px solid var(--line); }
  .specs__grid dt { font: 600 12px var(--f-display); letter-spacing: .16em; text-transform: uppercase; color: var(--mute); }
  .specs__grid dd { font-size: clamp(26px, 3.2vw, 56px); line-height: 1; text-transform: none; }
  @media (min-width: 900px) { .specs__grid { grid-template-columns: repeat(4, 1fr); } .specs__grid div { padding-left: 18px; border-left: 1px solid var(--line); } .specs__grid div:nth-child(4n+1) { padding-left: 0; border-left: 0; } }

  .story { display: grid; gap: 22px; padding-block: 0 clamp(80px, 12vw, 190px); }
  .story__text { max-width: 24ch; font-size: clamp(34px, 5.4vw, 96px); line-height: 1; }

  .chapter { padding-block: clamp(50px, 8vw, 120px) 0; }
  .chapter__head { display: grid; gap: 10px; margin-bottom: clamp(24px, 4vw, 56px); }
  .gallery { display: grid; gap: 14px; padding-inline: var(--gutter); }
  .shot { position: relative; overflow: hidden; aspect-ratio: 3 / 2; background: #ddd; }
  @media (min-width: 900px) {
    .gallery { grid-template-columns: repeat(12, 1fr); gap: clamp(14px, 1.6vw, 26px); align-items: start; }
    .s0 { grid-column: 1 / 13; aspect-ratio: 21 / 9; }
    .s1 { grid-column: 1 / 8; } .s2 { grid-column: 8 / 13; aspect-ratio: 4 / 5; margin-top: 6vw; }
    .s3 { grid-column: 2 / 7; aspect-ratio: 4 / 5; } .s4 { grid-column: 7 / 13; margin-top: 8vw; }
  }

  .equip { display: grid; gap: 34px; padding-block: clamp(90px, 13vw, 200px); }
  .equip header { display: grid; gap: 12px; align-content: start; }
  .equip__list { border-top: 1px solid var(--line); }
  .equip__list li { padding: 18px 0; border-bottom: 1px solid var(--line); font-size: clamp(18px, 1.8vw, 26px); }
  .equip__list li::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 18px; background: var(--red); }
  @media (min-width: 900px) { .equip { grid-template-columns: .8fr 1.2fr; gap: 8vw; } }

  .next { position: relative; display: grid; min-height: 62svh; overflow: hidden; color: #fff; isolation: isolate; }
  .next__img { position: absolute; inset: 0; z-index: -2; }
  .next__img :global(img) { transition: transform 1.6s var(--ease); }
  .next:hover .next__img :global(img) { transform: scale(1.04); }
  .next::after { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(5,5,6,.85), rgba(5,5,6,.1) 70%); }
  .next__copy { align-self: end; display: grid; gap: 14px; justify-items: start; padding-bottom: clamp(28px, 6vh, 64px); }
  .contact { display: grid; gap: 50px; padding-block: clamp(90px, 13vw, 200px); }
  .contact header { display: grid; gap: 16px; align-content: start; }
  @media (min-width: 900px) { .contact { grid-template-columns: .9fr 1.1fr; gap: 8vw; } }
</style>
