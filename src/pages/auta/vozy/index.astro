---
import Base from '../../../layouts/Base.astro'
import Hero from '../../../components/Hero.astro'
import Img from '../../../components/Img.astro'
import InquiryForm from '../../../components/InquiryForm.astro'
import {u} from '../../../lib/url'
import {getContent, czk, km, statusLabel} from '../../../lib/content'
import {coverFor} from '../../../data/vehicleMedia'

const {vehicles} = await getContent()
const list = vehicles.filter((v) => v.status !== 'sold')
---
<Base
  world="auta"
  title="Vozy v nabídce — Mužíček Auta"
  description="Aktuální nabídka vozů Mužíček: Audi RS4 Avant, Volkswagen Multivan, Jaguar XJ Sovereign, Škoda Octavia RS a další. Prověřené vozy z Jablonce nad Nisou."
  image="rs4-1"
>
  <Hero world="auta" num="01" kicker="Auta · Nabídka" image="rs4-1" pos="50% 60%" alt="Audi RS4 Avant v showroomu Mužíček" title={['Vozy v nabídce']} short
    lede="Aktuální nabídka. Dostupnost a cenu potvrzujeme při domluvě prohlídky." actions={[{label: 'Poptat konkrétní vůz', href: '#poptavka'}, {label: 'Dovoz na zakázku', href: '/auta/dovoz-vozidel/'}]} />

  <section class="list" aria-label="Vozy v nabídce">
    {list.map((v, i) => (
      <article class:list={['spread', i % 2 ? 'is-flip' : '']} aria-labelledby={`v-${v.slug}`}>
        <a class="spread__img frame" href={u(`/auta/vozy/${v.slug}/`)} tabindex="-1" aria-hidden="true" data-reveal="mask" data-parallax-host>
          <Img id={coverFor(v.slug) ?? 'rs4-1'} class="cover" alt="" data-parallax="0.07" sizes="(min-width: 900px) 62vw, 100vw" eager={i === 0} />
        </a>
        <div class="spread__body">
          <p class="label"><b class="num">{String(i + 1).padStart(2, '0')}</b> · {statusLabel(v.status)}</p>
          <h2 class="serif t-l" id={`v-${v.slug}`} data-split><a href={u(`/auta/vozy/${v.slug}/`)}>{v.title}</a></h2>
          <p class="spread__sub mute">{v.subtitle?.replaceAll(' · ', ', ')}</p>
          <dl class="spread__spec" data-stagger>
            {v.year && <div><dt>Rok</dt><dd class="num">{v.year}</dd></div>}
            {v.mileage != null && <div><dt>Nájezd</dt><dd class="num">{km(v.mileage)}</dd></div>}
            {v.power && <div><dt>Výkon</dt><dd class="num">{v.power}</dd></div>}
            <div><dt>Cena</dt><dd class="num spread__price">{czk(v.price)}</dd></div>
          </dl>
          <a class="link" href={u(`/auta/vozy/${v.slug}/`)}>Detail vozu</a>
        </div>
      </article>
    ))}
  </section>

  <section class="contact wrap" id="poptavka" aria-labelledby="contact-title">
    <header>
      <p class="label">Nenašli jste, co hledáte?</p>
      <h2 id="contact-title" class="serif t-xl" data-split>Najdeme to pro vás.</h2>
      <p class="mute lede">Zakázkový dovoz včetně výběru, prověření a veškeré administrativy.</p>
    </header>
    <InquiryForm area="auta" />
  </section>
</Base>

<style>
  .list { padding-block: clamp(60px, 9vw, 140px) 0; }
  .spread { display: grid; gap: 26px; padding: 0 var(--gutter); margin-bottom: clamp(70px, 10vw, 160px); }
  .spread__img { aspect-ratio: 3 / 2; display: block; }
  .spread__body { display: grid; gap: 18px; align-content: center; justify-items: start; }
  .spread__sub { font-size: 18px; }
  .spread__spec { display: grid; grid-template-columns: 1fr 1fr; width: 100%; max-width: 560px; border-top: 1px solid var(--line); }
  .spread__spec div { display: grid; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .spread__spec dt { font: 600 12px var(--f-display); letter-spacing: .16em; text-transform: uppercase; color: var(--mute); }
  .spread__spec dd { font: 600 clamp(20px, 1.8vw, 26px) var(--f-display); letter-spacing: .03em; }
  .spread__price { color: var(--red); }
  @media (min-width: 900px) {
    .spread { grid-template-columns: repeat(12, 1fr); gap: 0 clamp(24px, 3.4vw, 60px); align-items: center; }
    .spread__img { grid-column: 1 / 8; aspect-ratio: 4 / 3; } .spread__body { grid-column: 8 / 13; }
    .spread.is-flip .spread__img { grid-column: 6 / 13; grid-row: 1; } .spread.is-flip .spread__body { grid-column: 1 / 6; grid-row: 1; }
    .spread__body :global(h2) { font-size: clamp(40px, 4.8vw, 84px); }
  }
  .contact { display: grid; gap: 50px; padding-block: clamp(90px, 13vw, 200px); border-top: 1px solid var(--line); }
  .contact header { display: grid; gap: 16px; align-content: start; }
  @media (min-width: 900px) { .contact { grid-template-columns: .9fr 1.1fr; gap: 8vw; } }
</style>
