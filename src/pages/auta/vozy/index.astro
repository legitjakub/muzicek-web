---
import {VisualEditing} from '@sanity/astro/visual-editing'
import {sanity} from '../../../lib/sanity'
import '../../../styles/site.css'
import MicrositeHeader from '../../../components/MicrositeHeader.astro'
import SiteFooter from '../../../components/SiteFooter.astro'
import MotionDirector from '../../../components/MotionDirector.astro'
import {vehicleImageFor, vehiclePrice, vehicleStatusLabel, vehicleSubtitle} from '../../../lib/vehicleDisplay'

type Vehicle={title:string;slug:string;subtitle?:string;price?:number;year?:number;mileage?:number;status:string;cover:string}
const vehicles=await sanity.fetch<Vehicle[]>(`*[_type=="vehicle"]|order(featured desc,_createdAt desc){title,"slug":slug.current,subtitle,price,year,mileage,status,"cover":coverImage.asset->url}`)
const links=[{label:'Vozy v nabídce',href:'/auta/vozy/'},{label:'Dovoz',href:'/auta/dovoz-vozidel/'},{label:'Prodej',href:'/auta/prodej-vaseho-vozu/'},{label:'Přeprava',href:'/auta/preprava-vozidel/'},{label:'Kontakt',href:'#kontakt'}]
const featured=vehicles[0]
const remaining=vehicles.slice(1)
const mileage=(value?:number)=>value?`${new Intl.NumberFormat('cs-CZ').format(value)} km`:null
---
<!doctype html><html lang="cs"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Aktuální nabídka prověřených vozů Mužíček v Jablonci nad Nisou."/><title>Vozy v nabídce — Mužíček Auta</title></head><body>
<MicrositeHeader section="auta" tone="dark" links={links}/>
<main class="catalog" id="main-content"><header class="catalog__head page-width"><p class="kicker">Mužíček Auta <span> / Výběr vozů</span></p><h1>Vozy v nabídce</h1><div class="catalog__head-bottom"><p>Každý vůz osobně známe. Stav, historii i podmínky prodeje vysvětlíme dřív, než se rozhodnete přijet.</p></div></header>
{featured&&<section class="catalog-feature"><a href={`/auta/vozy/${featured.slug}/`} aria-label={`Detail vozu ${featured.title}`}><img src={vehicleImageFor(featured)} alt={featured.title} data-parallax/><div class="catalog-feature__shade"></div><div class="catalog-feature__content"><p class="kicker">{vehicleStatusLabel(featured.status)} <span>·</span> {featured.year}</p><h2>{featured.title}</h2><p>{vehicleSubtitle(featured.subtitle)}</p><div><strong>{vehiclePrice(featured.price)}</strong><span>Prohlédnout vůz <span aria-hidden="true">↗</span></span></div></div></a></section>}
<section class="catalog__list page-width"><div class="catalog__list-head"><h2>Další vozy</h2></div><div class="catalog__grid">{remaining.map((vehicle)=><a class="catalog-car" href={`/auta/vozy/${vehicle.slug}/`}><div class="catalog-car__image"><img src={vehicleImageFor(vehicle)} alt={vehicle.title} loading="lazy"/><span>{vehicleStatusLabel(vehicle.status)}</span></div><div class="catalog-car__info"><h3>{vehicle.title}</h3><p>{vehicleSubtitle(vehicle.subtitle)}</p><div class="catalog-car__bottom"><span>{[vehicle.year,mileage(vehicle.mileage)].filter(Boolean).join(' / ')}</span><strong>{vehiclePrice(vehicle.price)}</strong></div></div></a>)}</div></section>
<section class="catalog__help" id="kontakt"><div class="page-width"><p class="kicker">Nenašli jste to pravé?</p><h2>Najdeme vůz podle vašeho zadání.</h2><a class="button button--red" href="/auta/dovoz-vozidel/">Zakázkový dovoz</a></div></section></main>
<SiteFooter section="Auta"/><MotionDirector/><VisualEditing enabled={import.meta.env.DEV}/></body></html>
<style>
  .catalog{padding-top:92px}
  .catalog-car__image{position:relative;overflow:hidden}
  .catalog-car__image img{width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.8,.2,1)}
  .catalog-car:hover img{transform:scale(1.025)}
  .catalog-car__image span{position:absolute;left:20px;top:20px;padding:9px 12px;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}
  .catalog-car__info{display:flex;flex-direction:column}
  .catalog-car__info p{margin:0;color:#65645f}
  .catalog__help{padding:130px 0;background:#d9d5ca}
  .catalog__help h2{max-width:1000px;margin:22px 0 45px;font-size:clamp(52px,7vw,105px);line-height:.9;letter-spacing:-.055em}
  .catalog{background:#0b0b0b;color:#fff}
  .catalog__head{padding-top:clamp(160px,19vw,270px);padding-bottom:72px}
  .catalog__head .kicker span{color:#777}
  .catalog__head h1{max-width:1300px;margin:36px 0 55px;font-family:'Avenir Next Condensed','DIN Condensed','Helvetica Neue',sans-serif;font-size:clamp(76px,12.5vw,192px);font-weight:800;text-transform:uppercase;line-height:.78;letter-spacing:-.072em}
  .catalog__head-bottom{display:flex;justify-content:space-between;align-items:end;gap:35px;border-top:1px solid #494949;padding-top:22px}
  .catalog__head-bottom p{max-width:610px;margin:0;color:#aaa;font-size:15px;line-height:1.65}
  .catalog-feature a{position:relative;display:block;min-height:600px;height:78svh;max-height:850px;overflow:hidden;background:#252525}
  .catalog-feature img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:center 58%;transition:transform 1.2s cubic-bezier(.2,.7,.2,1)}
  .catalog-feature a:hover img{transform:scale(1.025)}
  .catalog-feature__shade{position:absolute;inset:0;background:linear-gradient(0deg,rgba(0,0,0,.88),rgba(0,0,0,.08) 68%),linear-gradient(90deg,rgba(0,0,0,.23),transparent)}
  .catalog-feature__content{position:absolute;right:clamp(20px,5vw,80px);bottom:clamp(35px,6vw,90px);left:clamp(20px,5vw,80px)}
  .catalog-feature__content .kicker span{color:var(--red);padding-inline:6px}
  .catalog-feature h2{max-width:1050px;margin:20px 0 10px;font-size:clamp(56px,9vw,140px);line-height:.82;letter-spacing:-.06em}
  .catalog-feature__content>p:not(.kicker){max-width:660px;color:#ddd;font-size:15px}
  .catalog-feature__content>div{display:flex;justify-content:space-between;align-items:center;gap:25px;margin-top:40px;padding-top:19px;border-top:1px solid #ffffff7a}
  .catalog-feature__content strong{font-size:21px}
  .catalog-feature__content>div>span{font-size:11px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}
  .catalog-feature__content>div>span span{margin-left:15px;color:var(--red);font-size:23px}
  .catalog__list{max-width:none;margin:0;padding:110px max(5vw,calc((100vw - 1460px)/2)) 135px;background:#eeeae2;color:#111}
  .catalog__list-head{margin-bottom:25px;padding-bottom:16px;border-bottom:1px solid #a8a49b}
  .catalog__list-head h2{margin:0;font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(37px,4vw,58px);font-weight:400;line-height:1}
  .catalog__grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(25px,4vw,58px) 20px}
  .catalog-car,.catalog-car:nth-child(even){display:block;min-height:0;margin:0;background:transparent;color:#111}
  .catalog-car:first-child{display:grid;grid-template-columns:1.25fr .75fr;grid-column:1/-1;min-height:500px;margin-bottom:20px;background:#d7d3ca}
  .catalog-car__image{height:clamp(300px,34vw,480px);background:#ccc}
  .catalog-car:first-child .catalog-car__image{height:100%}
  .catalog-car__image img{display:block}
  .catalog-car__image span{top:18px;left:18px;background:#eeeae2;color:#111}
  .catalog-car__info{display:flex;justify-content:flex-start;min-height:230px;padding:25px 0}
  .catalog-car:first-child .catalog-car__info{justify-content:center;padding:clamp(35px,5vw,80px)}
  .catalog-car__info small{font-size:10px;letter-spacing:.12em}
  .catalog-car__info h3{margin:20px 0 10px;font-size:clamp(36px,4.2vw,64px);line-height:.93;letter-spacing:-.045em}
  .catalog-car__info p{font-size:13px;line-height:1.5}
  .catalog-car__bottom{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:auto;padding-top:24px;border-top:1px solid #aaa}
  .catalog-car__bottom span{color:#777;font-size:11px;white-space:nowrap}
  .catalog-car__bottom strong{margin:0;font-size:16px;white-space:nowrap}
  .catalog__help{color:#111}
  @media(max-width:900px){.catalog-car:first-child{min-height:0}.catalog-car:first-child .catalog-car__image{height:440px}.catalog__grid{gap:35px 16px}}
  @media(max-width:760px){.catalog{padding-top:76px}.catalog__head{padding-top:145px;padding-bottom:50px}.catalog__head h1{font-size:clamp(70px,17vw,125px);margin:30px 0 50px}.catalog-feature a{height:66svh;min-height:540px}.catalog-feature h2{font-size:clamp(54px,12vw,95px)}.catalog__list{padding:78px 18px 90px}.catalog-car:first-child{grid-template-columns:1fr}.catalog-car:first-child .catalog-car__image{height:60vw;min-height:290px}.catalog-car:first-child .catalog-car__info{min-height:280px;padding:32px}.catalog__grid{grid-template-columns:1fr}.catalog-car__image{height:65vw}.catalog-car__info{min-height:210px}.catalog__help{padding-block:90px}}
  @media(max-width:480px){.catalog__head{padding-top:135px}.catalog__head h1{font-size:clamp(66px,18vw,86px)}.catalog__head-bottom{align-items:start}.catalog__head-bottom p{font-size:13px}.catalog-feature__content>div{align-items:start;flex-direction:column;gap:12px}.catalog-feature__content>div>span{font-size:10px}.catalog-car__bottom{align-items:start;flex-direction:column;gap:6px}}
</style>
