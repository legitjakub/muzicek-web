---
import {VisualEditing} from '@sanity/astro/visual-editing'
import {sanity} from '../../../lib/sanity'
import '../../../styles/site.css'
import MicrositeHeader from '../../../components/MicrositeHeader.astro'
import SiteFooter from '../../../components/SiteFooter.astro'

type Vehicle={title:string;slug:string;subtitle?:string;price?:number;year?:number;mileage?:number;status:string;cover:string}
const vehicles=await sanity.fetch<Vehicle[]>(`*[_type=="vehicle"]|order(featured desc,_createdAt desc){title,"slug":slug.current,subtitle,price,year,mileage,status,"cover":coverImage.asset->url}`)
const links=[{label:'Vozy v nabídce',href:'/auta/vozy/'},{label:'Dovoz',href:'/auta/dovoz-vozidel/'},{label:'Prodej',href:'/auta/prodej-vaseho-vozu/'},{label:'Přeprava',href:'/auta/preprava-vozidel/'},{label:'Kontakt',href:'#kontakt'}]
const money=(price?:number)=>price?`${new Intl.NumberFormat('cs-CZ').format(price)} Kč`:'Cena na dotaz'
const cleanText=(value?:string)=>value?.replaceAll(/\s*\u00b7\s*/g, ', ')
---
<!doctype html><html lang="cs"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="Aktuální nabídka prověřených vozů Mužíček v Jablonci nad Nisou."/><title>Vozy v nabídce — Mužíček Auta</title></head><body>
<MicrositeHeader section="auta" tone="light" links={links}/>
<main class="catalog" id="main-content"><header class="catalog__head page-width"><p class="kicker">Mužíček Auta</p><h1>Vozy v nabídce</h1><p>Každý vůz osobně známe. Stav, historii i podmínky prodeje vysvětlíme dřív, než se rozhodnete přijet.</p></header>
<section class="catalog__list page-width">{vehicles.map((vehicle,index)=><a class="catalog-car" href={`/auta/vozy/${vehicle.slug}/`}><div class="catalog-car__image"><img src={vehicle.cover} alt={vehicle.title}/><span>{vehicle.status==='reserved'?'Rezervováno':vehicle.status==='sold'?'Prodáno':'V nabídce'}</span></div><div class="catalog-car__info"><small>{String(index+1).padStart(2,'0')}</small><h2>{vehicle.title}</h2><p>{cleanText(vehicle.subtitle)}</p><strong>{money(vehicle.price)}</strong></div></a>)}</section>
<section class="catalog__help" id="kontakt"><div class="page-width"><p class="kicker">Nenašli jste to pravé?</p><h2>Najdeme vůz podle vašeho zadání.</h2><a class="button button--red" href="/auta/dovoz-vozidel/">Zakázkový dovoz</a></div></section></main>
<SiteFooter section="Auta"/><VisualEditing enabled={import.meta.env.DEV}/></body></html>
<style>
  .catalog{padding-top:92px;background:#f3f2ed}.catalog__head{padding-block:130px 85px}.catalog__head h1{margin:22px 0 30px;font-size:clamp(58px,9vw,138px);line-height:.84;letter-spacing:-.06em}.catalog__head>p:last-child{max-width:610px;margin-left:auto;font-size:18px;line-height:1.7}.catalog__list{padding-bottom:150px}.catalog-car{display:grid;grid-template-columns:1.25fr .75fr;min-height:520px;margin-bottom:70px;background:#e4e1da}.catalog-car:nth-child(even){grid-template-columns:.75fr 1.25fr}.catalog-car:nth-child(even) .catalog-car__image{order:2}.catalog-car__image{position:relative;overflow:hidden}.catalog-car__image img{width:100%;height:100%;object-fit:cover;transition:transform .8s cubic-bezier(.2,.8,.2,1)}.catalog-car:hover img{transform:scale(1.025)}.catalog-car__image span{position:absolute;left:20px;top:20px;padding:9px 12px;background:#f3f2ed;font-size:9px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.catalog-car__info{display:flex;flex-direction:column;justify-content:center;padding:clamp(34px,5vw,80px)}.catalog-car__info small{color:var(--red);font-weight:800}.catalog-car__info h2{margin:30px 0 12px;font-size:clamp(35px,4.5vw,68px);line-height:.93;letter-spacing:-.045em}.catalog-car__info p{margin:0;color:#65645f}.catalog-car__info strong{margin-top:50px;font-size:18px}.catalog__help{padding:130px 0;background:#d9d5ca}.catalog__help h2{max-width:1000px;margin:22px 0 45px;font-size:clamp(52px,7vw,105px);line-height:.9;letter-spacing:-.055em}
  @media(max-width:760px){.catalog{padding-top:76px}.catalog__head{padding-block:100px 65px}.catalog__head>p:last-child{margin-left:0}.catalog-car,.catalog-car:nth-child(even){grid-template-columns:1fr}.catalog-car:nth-child(even) .catalog-car__image{order:0}.catalog-car__image{min-height:62vw}.catalog-car__info{min-height:340px}.catalog__list{padding-bottom:90px}}
</style>
