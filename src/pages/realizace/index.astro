---
import Base from '../../layouts/Base.astro'
import Hero from '../../components/Hero.astro'
import Img from '../../components/Img.astro'
import FilmChapter from '../../components/FilmChapter.astro'
import InquiryForm from '../../components/InquiryForm.astro'
import {u} from '../../lib/url'
import {projects} from '../../data/projects'

const rs6 = projects[0]
const bench = [
  {id: 'film-peel', t: 'Stahování ochranné vrstvy', href: '/detailing/ppf/'}, {id: 'wrench-brake', t: 'Utahování brzdového třmenu', href: '/servis/servis-a-performance/'},
  {id: 'dry-ice-5', t: 'Čištění podvozku suchým ledem', href: '/servis/suchy-led/'}, {id: 'tint-3', t: 'Tónování skel', href: '/detailing/tonovani-skel/'},
  {id: 'battery', t: 'Kontrola motorového prostoru', href: '/servis/servis-a-performance/'}, {id: 'ppf-door', t: 'Ruční aplikace PPF po dílech', href: '/detailing/ppf/'},
  {id: 'caliper', t: 'Karbon-keramická brzda', href: '/servis/servis-a-performance/'}, {id: 'van-trailer', t: 'Krytá přeprava vozů', href: '/auta/preprava-vozidel/'},
]
---
<Base
  world="detailing"
  title="Realizace — Mužíček"
  description="Realizace Mužíček: Audi RS6 Avant s kompletní péčí, práce z dílny, renovace Corvette ZR1 a vozy z naší nabídky."
  image={rs6.hero}
>
  <Hero world="detailing" num="—" kicker="Realizace" image="rs6-16" pos="50% 60%" alt="Audi RS6 Avant v hale Mužíček" title={['Práce,', 'která je vidět.']}
    lede="Vozy, na kterých jsme pracovali — od ochrany laku po renovaci a servis." actions={[{label: 'Audi RS6 Avant', href: '/realizace/audi-rs6/'}, {label: 'Z dílny', href: '#dilna'}]} />

  <section class="lead" aria-labelledby="lead-title">
    <a class="lead__img frame" href={u(`/realizace/${rs6.slug}/`)} tabindex="-1" aria-hidden="true" data-reveal="mask" data-parallax-host><Img id="rs6-1" class="cover" alt="" data-parallax="0.07" sizes="(min-width: 900px) 64vw, 100vw" /></a>
    <div class="lead__copy">
      <p class="label">Příběh · {rs6.year}</p>
      <h2 id="lead-title" class="display t-xl" data-split><a href={u(`/realizace/${rs6.slug}/`)}>{rs6.title}</a></h2>
      <p class="num lead__meta">{rs6.engine} · {rs6.power}</p>
      <p class="lede">{rs6.lede}</p>
      <ul class="lead__care" data-stagger>{rs6.care.map((c) => <li>{c.t}</li>)}</ul>
      <a class="link" href={u(`/realizace/${rs6.slug}/`)}>Celý příběh</a>
    </div>
  </section>

  <section class="reel" id="dilna" data-hscroll aria-labelledby="reel-title">
    <div class="reel__stage">
      <div class="reel__rail" data-rail>
        <div class="reel__intro">
          <p class="label">Z dílny</p>
          <h2 id="reel-title" class="display t-l">Ruce, nástroje, světlo.</h2>
          <p class="mute">Každý záběr vede na službu, ze které pochází.</p>
        </div>
        {bench.map((b, i) => (
          <a class:list={['reel__item', `r${i % 3}`]} href={u(b.href)}>
            <Img id={b.id} class="reel__img" alt="" sizes="(min-width: 900px) 40vh, 72vw" />
            <span class="cap"><b class="num">{String(i + 1).padStart(2, '0')}</b> {b.t}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FilmChapter videoId="GmGAPUCy2EU" kicker="Individuální renovace" title="Corvette ZR1 — zpět k původnímu lesku" text="Renovace, která stojí na čase, trpělivosti a síti ověřených specialistů v Česku i zahraničí." />

  <section class="cars wrap" aria-labelledby="cars-title">
    <p class="label" data-reveal="fade">Auta</p>
    <h2 id="cars-title" class="serif t-xl" data-split>Vozy z naší nabídky.</h2>
    <div class="cars__row" data-stagger>
      <Img id="rs4-1" alt="Audi RS4 Avant" sizes="(min-width: 900px) 30vw, 90vw" /><Img id="jaguar-2" alt="Jaguar XJ Sovereign" sizes="(min-width: 900px) 30vw, 90vw" /><Img id="multivan-1" alt="Volkswagen Multivan" sizes="(min-width: 900px) 30vw, 90vw" />
    </div>
    <a class="link" href={u('/auta/vozy/')}>Aktuální nabídka</a>
  </section>

  <section class="contact wrap" id="poptavka" aria-labelledby="contact-title">
    <header><p class="label">Máte vlastní zadání?</p><h2 id="contact-title" class="display t-xl" data-split>Řekněte nám, co s vozem chcete.</h2></header>
    <InquiryForm area="detailing" />
  </section>
</Base>

<style>
  .lead { display: grid; background: var(--graphite); color: #fff; }
  .lead__img { display: block; min-height: 64svh; }
  .lead__copy { display: grid; gap: 20px; align-content: center; justify-items: start; padding: 56px var(--gutter) 70px; }
  .lead__meta { font: 600 15px var(--f-display); letter-spacing: .14em; color: rgba(255,255,255,.7); }
  .lead__care { width: 100%; max-width: 54ch; border-top: 1px solid rgba(255,255,255,.22); }
  .lead__care li { padding: 10px 0; border-bottom: 1px solid rgba(255,255,255,.22); font-size: 15px; }
  .lead__care li::before { content: '+'; margin-right: 12px; color: var(--red); }
  @media (min-width: 900px) { .lead { grid-template-columns: 1.3fr .7fr; min-height: 100svh; } .lead__copy { padding: 7vw 4vw; } .lead__copy h2 { font-size: clamp(54px, 6.4vw, 120px); } }

  .reel { padding-block: clamp(70px, 9vw, 130px) 0; }
  .reel__rail { display: flex; align-items: center; gap: clamp(20px, 3vw, 48px); padding: 0 var(--gutter) 40px; overflow-x: auto; scroll-snap-type: x proximity; }
  .reel__intro { flex: 0 0 min(80vw, 520px); display: grid; gap: 18px; }
  .reel__item { flex: 0 0 min(72vw, 360px); scroll-snap-align: start; display: grid; gap: 4px; }
  .reel__item :global(img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; transition: transform 1s var(--ease); }
  .reel__item { overflow: hidden; }
  .reel__item:hover :global(img) { transform: scale(1.03); }
  .reel__item .cap b { color: var(--red); margin-right: 8px; }
  .reel.is-pinned { padding: 0; }
  .reel.is-pinned .reel__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; display: grid; align-items: center; }
  .reel.is-pinned .reel__rail { overflow: visible; padding-bottom: 0; transform: translate3d(var(--hx, 0px), 0, 0); will-change: transform; width: max-content; }
  .reel.is-pinned .reel__intro { flex-basis: min(34vw, 520px); padding-right: 4vw; }
  .reel.is-pinned .reel__item { flex-basis: auto; }
  .reel.is-pinned .reel__item :global(img) { height: min(60vh, 600px); width: auto; aspect-ratio: 4 / 5; }
  .reel.is-pinned .r1 { align-self: flex-start; margin-top: 14vh; } .reel.is-pinned .r2 { align-self: flex-end; margin-bottom: 9vh; }

  .cars { display: grid; gap: 26px; padding-block: clamp(90px, 13vw, 200px); justify-items: start; }
  .cars__row { display: grid; gap: 14px; width: 100%; }
  .cars__row :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  @media (min-width: 900px) { .cars__row { grid-template-columns: repeat(3, 1fr); gap: 20px; } .cars__row :global(img:nth-child(2)) { margin-top: 5vw; } .cars__row :global(img:nth-child(3)) { margin-top: 10vw; } }

  .contact { display: grid; gap: 50px; padding-block: clamp(90px, 13vw, 200px); border-top: 1px solid var(--line); }
  .contact header { display: grid; gap: 16px; align-content: start; }
  .contact h2 { max-width: 12ch; }
  @media (min-width: 900px) { .contact { grid-template-columns: .95fr 1.05fr; gap: 8vw; } }
</style>
