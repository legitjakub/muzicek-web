---
import Base from '../../layouts/Base.astro'
import Hero from '../../components/Hero.astro'
import Img from '../../components/Img.astro'
import InquiryForm from '../../components/InquiryForm.astro'
import {u} from '../../lib/url'
import {getContent} from '../../lib/content'
import {projects, type Project} from '../../data/projects'

export function getStaticPaths() {
  return projects.map((p) => ({params: {project: p.slug}, props: {project: p}}))
}
const {project} = Astro.props as {project: Project}
const {services} = await getContent()
const used = [...new Set(project.care.map((c) => c.service))].map((s) => services.find((x) => x.slug === s)!).filter(Boolean)
---
<Base
  world="detailing"
  title={`${project.title} — realizace | Mužíček`}
  description={`${project.title} (${project.year}, ${project.engine}, ${project.power}): ${project.lede}`}
  image={project.hero}
>
  <link slot="head" rel="preload" as="image" href={u(`/img/${project.hero}-1600.webp`)} imagesrcset={`${u(`/img/${project.hero}-800.webp`)} 800w, ${u(`/img/${project.hero}-1600.webp`)} 1600w`} imagesizes="100vw" fetchpriority="high" />

  <Hero world="detailing" num="—" kicker="Realizace" image={project.hero} pos={project.heroPos} alt={`${project.title} po kompletní péči`} title={[project.title]}
    lede={project.lede} facts={[{k: 'Ročník', v: project.year}, {k: 'Motor', v: project.engine}, {k: 'Výkon', v: project.power}]}
    actions={[{label: 'Péče od nás', href: '#pece'}, {label: 'Všechny realizace', href: '/realizace/'}]} />

  <!-- what was done: numbered, each line leads to the service -->
  <section class="care" id="pece" aria-labelledby="care-title">
    <div class="care__head wrap">
      <p class="label" data-reveal="fade">Péče od nás</p>
      <h2 id="care-title" class="display t-xl" data-split>Co jsme na voze udělali.</h2>
    </div>
    <ol class="care__list wrap" data-stagger>
      {project.care.map((c, i) => {
        const s = services.find((x) => x.slug === c.service)
        return (
          <li><a href={u(`/detailing/${c.service}/`)}><span class="care__n num">0{i + 1}</span><span class="care__t display">{c.t}</span><span class="care__s">{s?.title}</span></a></li>
        )
      })}
    </ol>
  </section>

  <!-- exterior: pinned horizontal sequence -->
  <section class="rail" data-hscroll aria-labelledby="ext-title">
    <div class="rail__stage">
      <div class="rail__track" data-rail>
        <div class="rail__intro"><p class="label">Exteriér</p><h2 id="ext-title" class="display t-l">Lak, fólie, lesk.</h2></div>
        {project.exterior.map((s, i) => <figure class="rail__item"><Img id={s.id} alt={s.alt} sizes="(min-width: 900px) 70vh, 88vw" /><figcaption class="cap"><b class="num">{String(i + 1).padStart(2, '0')}</b></figcaption></figure>)}
      </div>
    </div>
  </section>

  <section class="inside" aria-labelledby="int-title">
    <header class="wrap"><p class="label" data-reveal="fade">Interiér</p><h2 id="int-title" class="display t-xl" data-split>Chráněno i uvnitř.</h2></header>
    <div class="inside__grid">
      {project.interior.map((s, i) => <figure class:list={['in', `i${i % 4}`]} data-reveal="mask" data-parallax-host><Img id={s.id} class="cover" data-parallax="0.06" alt={s.alt} sizes="(min-width: 900px) 55vw, 100vw" /></figure>)}
    </div>
  </section>

  <section class="tech" aria-label="Technika">
    <figure class="tech__main frame" data-parallax-host data-reveal="mask"><Img id={project.technical[0].id} class="cover" data-parallax="0.08" alt={project.technical[0].alt} sizes="100vw" /></figure>
    <div class="tech__row wrap">
      {project.technical.slice(1).map((s) => <figure class="frame" data-reveal="mask-x"><Img id={s.id} class="cover" alt={s.alt} sizes="(min-width: 900px) 40vw, 100vw" /></figure>)}
      <div class="tech__note"><p class="label">Technika</p><p class="display t-m">{project.engine} · {project.power}</p></div>
    </div>
  </section>

  <section class="used wrap" aria-labelledby="used-title">
    <p class="label">Použité služby</p>
    <h2 id="used-title" class="sr-only">Použité služby</h2>
    <div class="used__list">
      {used.map((s) => <a href={u(`/detailing/${s.slug}/`)}><span class="display t-l">{s.title}</span><span class="used__s">{s.summary}</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6" /></svg></a>)}
    </div>
  </section>

  <section class="contact wrap" id="poptavka" aria-labelledby="contact-title">
    <header><p class="label">Podobné zadání?</p><h2 id="contact-title" class="display t-xl" data-split>Nejdřív se podíváme na váš vůz.</h2></header>
    <InquiryForm area="detailing" />
  </section>
</Base>

<style>
  .care { padding-block: clamp(90px, 13vw, 200px) 0; display: grid; gap: 50px; }
  .care__head { display: grid; gap: 16px; }
  .care__list { border-top: 1px solid var(--line); margin-inline: var(--gutter); width: auto; padding: 0; }
  .care__list a { display: grid; grid-template-columns: 44px 1fr; gap: 6px 14px; padding: 24px 0; border-bottom: 1px solid var(--line); transition: padding .5s var(--ease); }
  .care__list a:hover { padding-left: 14px; }
  .care__n { color: var(--red); font: 600 15px var(--f-display); letter-spacing: .1em; padding-top: .8em; }
  .care__t { font-size: clamp(30px, 4.6vw, 80px); line-height: .92; }
  .care__s { grid-column: 2; color: var(--mute); font: 600 13px var(--f-display); letter-spacing: .14em; text-transform: uppercase; }
  @media (min-width: 900px) { .care__list a { grid-template-columns: 70px 1fr 260px; align-items: center; } .care__s { grid-column: 3; text-align: right; } }

  .rail { padding-block: clamp(80px, 11vw, 160px) 0; }
  .rail__track { display: flex; align-items: center; gap: clamp(16px, 2vw, 32px); padding: 0 var(--gutter) 30px; overflow-x: auto; scroll-snap-type: x proximity; }
  .rail__intro { flex: 0 0 min(76vw, 460px); display: grid; gap: 14px; }
  .rail__item { flex: 0 0 min(88vw, 640px); scroll-snap-align: start; }
  .rail__item :global(img) { width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .rail__item b { color: var(--red); }
  .rail.is-pinned { padding: 0; }
  .rail.is-pinned .rail__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; display: grid; align-items: center; }
  .rail.is-pinned .rail__track { overflow: visible; padding-bottom: 0; width: max-content; transform: translate3d(var(--hx, 0px), 0, 0); will-change: transform; }
  .rail.is-pinned .rail__intro { flex-basis: min(30vw, 460px); padding-right: 3vw; }
  .rail.is-pinned .rail__item { flex-basis: auto; }
  .rail.is-pinned .rail__item :global(img) { height: min(66vh, 680px); width: auto; aspect-ratio: 3 / 2; }

  .inside { padding-block: clamp(90px, 13vw, 200px) 0; display: grid; gap: clamp(30px, 5vw, 70px); }
  .inside header { display: grid; gap: 14px; }
  .inside__grid { display: grid; gap: 14px; padding-inline: var(--gutter); }
  .in { position: relative; overflow: hidden; aspect-ratio: 3 / 2; background: #ccc; }
  @media (min-width: 900px) {
    .inside__grid { grid-template-columns: repeat(12, 1fr); gap: clamp(14px, 1.6vw, 26px); align-items: start; }
    .i0 { grid-column: 1 / 8; } .i1 { grid-column: 8 / 13; aspect-ratio: 4 / 5; margin-top: 8vw; }
    .i2 { grid-column: 2 / 7; aspect-ratio: 4 / 5; } .i3 { grid-column: 7 / 13; margin-top: 6vw; }
  }

  .tech { margin-top: clamp(90px, 13vw, 200px); }
  .tech__main { height: 100svh; min-height: 520px; }
  .tech__row { display: grid; gap: 14px; padding-block: 14px; }
  .tech__row .frame { aspect-ratio: 3 / 2; }
  .tech__note { display: grid; gap: 10px; align-content: center; padding: 30px 0; }
  @media (min-width: 900px) { .tech__row { grid-template-columns: 1fr 1fr 1fr; gap: 20px; padding-block: 20px; } }

  .used { display: grid; gap: 24px; padding-block: clamp(90px, 13vw, 200px) 0; }
  .used__list { border-top: 1px solid var(--line); }
  .used__list a { display: grid; grid-template-columns: 1fr 28px; gap: 8px 20px; align-items: center; padding: 28px 0; border-bottom: 1px solid var(--line); transition: padding .5s var(--ease); }
  .used__list a:hover { padding-left: 14px; }
  .used__s { grid-column: 1; max-width: 60ch; color: var(--mute); }
  .used__list svg { grid-row: 1 / 3; grid-column: 2; width: 28px; color: var(--red); }

  .contact { display: grid; gap: 50px; padding-block: clamp(90px, 13vw, 200px); }
  .contact header { display: grid; gap: 16px; align-content: start; }
  .contact h2 { max-width: 12ch; }
  @media (min-width: 900px) { .contact { grid-template-columns: .95fr 1.05fr; gap: 8vw; } }
</style>
