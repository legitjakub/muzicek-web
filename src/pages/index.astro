---
import Base from '../layouts/Base.astro'
import Img from '../components/Img.astro'
import {u} from '../lib/url'
import {worlds, contact} from '../data/site'
---
<Base
  title="Mužíček — auta, servis a detailing v Jablonci nad Nisou"
  description="Jeden automobilový ateliér, tři světy: dovoz a prodej vozů, servis a performance, detailing a ochrana laku. Jablonec nad Nisou."
  image="hala"
>
  <link slot="head" rel="preload" as="image" href={u('/img/hala-1600.webp')} imagesrcset={`${u('/img/hala-800.webp')} 800w, ${u('/img/hala-1600.webp')} 1600w`} imagesizes="100vw" fetchpriority="high" />

  <!-- ① brand introduction -->
  <section class="intro" aria-labelledby="intro-title">
    <div class="intro__media"><Img id="hala" class="cover" priority alt="Hala ateliéru Mužíček v Jablonci nad Nisou s vozy v showroomu" pos="50% 62%" /></div>
    <div class="intro__shade"></div>
    <div class="intro__copy wrap">
      <p class="label intro__kicker" data-reveal="fade" style="--delay:.15s">Mužíček · Auta · Servis · Detailing</p>
      <h1 id="intro-title" class="display" data-split style="--delay:.25s">Jeden ateliér.<br />Tři světy automobilu.</h1>
      <div class="intro__foot">
        <p class="lede" data-reveal="up" style="--delay:.45s">Vůz, práce a lidé, kteří za ní stojí. Od roku 2014 v Jablonci nad Nisou.</p>
        <a class="link intro__cue" href="#svety" data-reveal="fade" style="--delay:.65s">Vybrat svět</a>
      </div>
    </div>
    <div class="intro__word" aria-hidden="true" style={`--hall:url('${u('/img/hala-1600.webp')}')`}>Mužíček</div>
  </section>

  <!-- ② the selector: one sticky stage, three worlds -->
  <section class="hub" id="svety" data-hub aria-label="Tři světy Mužíček">
    <div class="hub__stage">
      {worlds.map((w, i) => (
        <article class="world" id={`svet-${w.key}`} data-state={i} data-w={w.key} data-parallax-host aria-labelledby={`world-title-${w.key}`}>
          <div class="world__media"><div class="world__par" data-parallax="0.06"><Img id={w.image} class="cover" alt="" pos={w.pos} eager={i === 0} sizes="100vw" /></div></div>
          <div class="world__tone" aria-hidden="true"></div>
          {w.key === 'servis' && <div class="world__ticks" aria-hidden="true"><i></i><i></i><i></i><i></i></div>}
          {w.key === 'detailing' && <div class="world__sweep" aria-hidden="true"></div>}
          <div class="world__copy wrap">
            <p class="world__idx label"><b class="num">{w.num}</b><span>/ 03</span><em>{w.accent}</em></p>
            <h2 class="world__title display" id={`world-title-${w.key}`}>
              <a href={u(w.href)} aria-label={`${w.num} ${w.title.join(' ')} — ${w.cta}`}>
                {w.title.map((line, k) => <span class="ln" style={`--lag:${k * 0.14}`}><span>{line}</span></span>)}
              </a>
            </h2>
            <div class="world__row">
              <p class="world__statement">{w.statement}</p>
              <div class="world__side">
                <ul class="world__tags" aria-label="Co najdete">{w.tags.map((t) => <li>{t}</li>)}</ul>
                <a class="link" href={u(w.href)}>{w.cta}</a>
              </div>
            </div>
          </div>
        </article>
      ))}
      <div class="hub__odo" aria-hidden="true"><span class="odo"><span class="odo__col"><i>1</i><i>2</i><i>3</i></span></span><span class="odo__of">/ 03</span></div>
      <nav class="hub__nav" aria-label="Vybrat svět">
        <span class="hub__bar" aria-hidden="true"><i></i></span>
        {worlds.map((w, i) => <a href={`#svet-${w.key}`} data-k={i}><b class="num">{w.num}</b><span>{w.label}</span></a>)}
      </nav>
    </div>
  </section>

  <!-- ③ after the selector: why one atelier -->
  <section class="manifest wrap" aria-labelledby="manifest-title">
    <div class="manifest__text">
      <p class="label" data-reveal="fade">Auto · Práce · Lidé</p>
      <h2 id="manifest-title" class="display t-l" data-split>Auto je začátek. Rozhoduje práce a lidé za ní.</h2>
      <p class="lede" data-reveal="up">Z malé dílny jsme od roku 2014 vybudovali studio, kde o vozy pečuje tým zkušených odborníků. Ke každému autu přistupujeme s péčí, jako by bylo naše vlastní.</p>
      <a class="link" href={u('/realizace/')} data-reveal="up">Podívat se na realizace</a>
    </div>
    <div class="manifest__stack" aria-hidden="false">
      <figure class="frame m1" data-parallax-host><Img id="hands-wrench" class="cover" data-parallax="0.1" alt="Ruce mechanika s montážním klíčem" sizes="(min-width: 900px) 30vw, 60vw" /></figure>
      <figure class="frame m2" data-parallax-host><Img id="ppf-door" class="cover" alt="Aplikace ochranné fólie na dveře vozu" sizes="(min-width: 900px) 40vw, 80vw" /></figure>
      <figure class="frame m3" data-parallax-host><Img id="polish-worker" class="cover" alt="Strojní leštění laku" sizes="(min-width: 900px) 24vw, 50vw" /></figure>
    </div>
  </section>

  <!-- ④ featured project -->
  <section class="feature" data-progress aria-labelledby="feature-title">
    <a class="feature__frame" href={u('/realizace/audi-rs6/')}>
      <Img id="rs6-1" class="cover" alt="Audi RS6 Avant po kompletní péči v showroomu Mužíček" sizes="100vw" />
      <span class="feature__shade"></span>
      <span class="feature__copy wrap">
        <span class="label">Realizace</span>
        <span class="display t-l" id="feature-title">Audi RS6 Avant</span>
        <span class="feature__meta">2021 · 4.0 TFSI V8 · 591 HP — PPF full polep, keramická ochrana, renovace laku</span>
        <span class="link">Příběh realizace</span>
      </span>
    </a>
  </section>

  <script>
    import {states, whenPinned, stateTop, smooth, pointerDepth} from '../scripts/core'
    const hub = document.querySelector<HTMLElement>('[data-hub]')
    if (hub) {
      const worldEls = [...hub.querySelectorAll<HTMLElement>('.world')]
      const links = [...hub.querySelectorAll<HTMLAnchorElement>('.hub__nav a')]
      const n = worldEls.length
      const mark = (i: number) => {
        worldEls.forEach((w, k) => w.toggleAttribute('inert', k !== i))
        links.forEach((a, k) => (k === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')))
      }
      const goTo = (k: number) => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
        if (hub.classList.contains('is-pinned')) scrollTo({top: stateTop(hub, k, n), behavior: reduce ? 'auto' : 'smooth'})
        else worldEls[k].scrollIntoView({behavior: reduce ? 'auto' : 'smooth', block: 'start'})
      }
      links.forEach((a, k) => {
        a.addEventListener('click', (e) => { e.preventDefault(); goTo(k) })
        a.addEventListener('keydown', (e) => {
          const d = e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : e.key === 'ArrowUp' || e.key === 'ArrowLeft' ? -1 : 0
          if (!d) return
          e.preventDefault()
          const next = Math.min(n - 1, Math.max(0, k + d))
          links[next].focus(); goTo(next)
        })
      })
      whenPinned(() => {
        const stopDepth = pointerDepth(hub)
        const stop = states(hub, {n, onIndex: mark, onFrame: (sc) => hub.style.setProperty('--odo', (smooth(0.84, 1.16, sc) + smooth(1.84, 2.16, sc)).toFixed(3))})
        const m = location.hash.match(/^#svet-(.+)$/)
        const k = m ? worldEls.findIndex((w) => w.dataset.w === m[1]) : -1
        if (k > 0) requestAnimationFrame(() => scrollTo({top: stateTop(hub, k, n), behavior: 'auto'}))
        return () => { stop(); stopDepth(); hub.style.removeProperty('--odo'); worldEls.forEach((w) => w.removeAttribute('inert')); links.forEach((a) => a.removeAttribute('aria-current')) }
      })
    }
  </script>
</Base>

<style>
  /* intro */
  .intro { position: relative; min-height: 100svh; display: grid; grid-template-rows: 1fr auto; overflow: hidden; color: #fff; isolation: isolate; background: #111; }
  .intro__media { position: absolute; inset: 0; z-index: -2; }
  .intro__media :global(img) { animation: intro-in 3s var(--ease) both; }
  .intro__shade { position: absolute; inset: 0; z-index: -1; background: linear-gradient(0deg, rgba(5,5,6,.9), rgba(5,5,6,.35) 55%, rgba(5,5,6,.2)), linear-gradient(90deg, rgba(5,5,6,.45), transparent 70%); }
  .intro__copy { align-self: end; display: grid; gap: clamp(14px, 2vh, 24px); padding-top: calc(var(--header-h) + 40px); }
  .intro__kicker { color: rgba(255,255,255,.78); }
  .intro h1 { font-size: clamp(36px, 5.4vw, 100px); line-height: .88; max-width: none; }
  .intro__foot { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 18px 24px; padding-top: clamp(12px, 2vh, 24px); border-top: 1px solid rgba(255,255,255,.28); }
  .intro__foot .lede { color: rgba(255,255,255,.86); max-width: 34ch; font-size: clamp(15px, 1.2vw, 19px); }
  /* the wordmark is a window: the letters show the bright, un-shaded hall */
  .intro__word { padding-inline: var(--gutter); font: 700 31vw/.74 var(--f-display); padding-top: .2em; margin: -.1em 0 .12em; letter-spacing: -.012em; text-transform: uppercase; white-space: nowrap; color: rgba(255,255,255,.92); user-select: none; }
  @supports (-webkit-background-clip: text) or (background-clip: text) {
    @media (min-width: 900px) and (hover: hover) {
      .intro__word { background: var(--hall) 50% 62% / cover no-repeat fixed; -webkit-background-clip: text; background-clip: text; color: transparent; filter: brightness(1.25) saturate(1.1); }
    }
  }
  @keyframes intro-in { from { transform: scale(1.2); filter: brightness(.55); } to { transform: scale(1.02); filter: none; } }
  :global(.rm) .intro__media :global(img) { animation: none; }

  /* hub — stacked layout (mobile, tablet portrait, reduced motion, no JS) */
  .hub { position: relative; background: #0b0b0c; color: #fff; }
  .world { position: relative; min-height: 100svh; display: grid; align-items: end; overflow: hidden; isolation: isolate; }
  .world__media { position: absolute; inset: 0; z-index: -3; }
  .world__par { position: absolute; inset: -6% 0; }
  .world__tone { position: absolute; inset: 0; z-index: -2; background: linear-gradient(0deg, rgba(5,5,6,.9), rgba(5,5,6,.05) 62%), linear-gradient(90deg, rgba(5,5,6,.35), transparent 70%); }
  .world[data-w='servis'] .world__media { filter: grayscale(.4) contrast(1.1) brightness(.92); }
  .world[data-w='servis'] .world__tone { background: linear-gradient(0deg, rgba(4,8,12,.92), rgba(6,10,16,.25) 70%), rgba(10,18,28,.28); }
  .world[data-w='detailing'] .world__media { filter: saturate(1.1) contrast(1.04); }
  .world__ticks i { position: absolute; width: 26px; height: 26px; border: 0 solid rgba(255,255,255,.7); }
  .world__ticks i:nth-child(1) { top: calc(var(--header-h) + 18px); left: var(--gutter); border-width: 1px 0 0 1px; }
  .world__ticks i:nth-child(2) { top: calc(var(--header-h) + 18px); right: var(--gutter); border-width: 1px 1px 0 0; }
  .world__ticks i:nth-child(3) { bottom: 22px; left: var(--gutter); border-width: 0 0 1px 1px; }
  .world__ticks i:nth-child(4) { bottom: 22px; right: var(--gutter); border-width: 0 1px 1px 0; }
  .world__sweep { position: absolute; inset: 0; z-index: -1; pointer-events: none; background: linear-gradient(100deg, transparent 38%, rgba(255,255,255,.3) 50%, transparent 62%); mix-blend-mode: soft-light; opacity: 0; }

  .world__copy { display: grid; gap: clamp(14px, 2.2vh, 26px); padding-top: calc(var(--header-h) + 30px); padding-bottom: clamp(40px, 8vh, 90px); }
  .world__idx { display: flex; gap: 10px; align-items: baseline; color: rgba(255,255,255,.8); }
  .world__idx b { color: #fff; font-size: 15px; }
  .world__idx em { margin-left: 14px; font-style: normal; color: #fff; }
  .world__idx em::before { content: ''; display: inline-block; width: 8px; height: 8px; margin-right: 10px; background: var(--red); }
  .world__title { font-size: clamp(76px, 25vw, 150px); line-height: .84; }
  .world__title a { display: block; }
  .world__title .ln { display: block; overflow: hidden; padding-bottom: .06em; margin-bottom: -.06em; }
  .world__title .ln > span { display: block; }
  .world[data-w='servis'] .world__title, .world[data-w='detailing'] .world__title { font-size: clamp(56px, 17vw, 120px); }
  .world__row { display: grid; gap: 22px; padding-top: clamp(14px, 2.4vh, 28px); border-top: 1px solid rgba(255,255,255,.3); }
  .world__statement { max-width: 36ch; font-size: clamp(17px, 1.6vw, 22px); line-height: 1.4; color: rgba(255,255,255,.92); }
  .world__side { display: grid; gap: 18px; justify-items: start; }
  .world__tags { display: flex; flex-wrap: wrap; gap: 6px 18px; font: 600 13px var(--f-display); letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.7); }
  .hub__nav { display: none; }

  /* hub — pinned cinematic stage (desktop, motion allowed) */
  .hub.is-pinned { height: 420vh; }
  .hub.is-pinned .hub__stage { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .hub.is-pinned .world { position: absolute; inset: 0; min-height: 0; overflow: hidden; }
  .hub.is-pinned .world:nth-of-type(2) { z-index: 2; }
  .hub.is-pinned .world:nth-of-type(3) { z-index: 3; }
  .hub.is-pinned .world {
    clip-path: inset(calc((1 - var(--in, 1)) * 100%) 0 0 0);
  }
  /* image: rises with the wipe, settles from a wider lens; outgoing image sinks and darkens */
  .hub.is-pinned .world__media { transform: translate3d(calc(var(--ptx, 0) * -18px), calc((1 - var(--in, 1)) * 10% - var(--out, 0) * 5% + var(--pty, 0) * -10px), 0) scale(calc(1.05 + (1 - var(--in, 1)) * .18 + var(--out, 0) * .08)); will-change: transform; }
  .hub.is-pinned .world::after { content: ''; position: absolute; inset: 0; z-index: -1; background: #000; opacity: calc(var(--out, 0) * .6); pointer-events: none; }
  .hub.is-pinned .world__idx { opacity: calc(clamp(0, (var(--in, 1) - .3) * 2, 1) * (1 - clamp(0, var(--out, 0) * 3, 1))); }
  .hub.is-pinned .world__title .ln > span { transform: translate3d(0, calc((1 - clamp(0, (var(--in, 1) - var(--lag, 0)) / (1 - var(--lag, 0)), 1)) * 108% - var(--out, 0) * 112%), 0); }
  .hub.is-pinned .world__row {
    opacity: calc(clamp(0, (var(--in, 1) - .55) * 2.4, 1) * (1 - clamp(0, var(--out, 0) * 3, 1)));
    transform: translate3d(0, calc((1 - clamp(0, (var(--in, 1) - .5) * 2, 1)) * 36px - var(--out, 0) * 30px), 0);
  }
  .hub.is-pinned .world__title { font-size: clamp(120px, 24vw, 430px); }
  .hub.is-pinned .world[data-w='servis'] .world__title, .hub.is-pinned .world[data-w='detailing'] .world__title { font-size: clamp(90px, 13.4vw, 250px); }
  .hub.is-pinned .world__copy { position: absolute; inset: 0; align-content: end; padding-bottom: clamp(28px, 6vh, 64px); }
  .hub.is-pinned .world__row { grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: 6vw; }
  .hub.is-pinned .world__side { justify-items: end; text-align: right; }
  .hub.is-pinned .world__tags { justify-content: flex-end; }
  .hub.is-pinned .world__sweep { opacity: 1; transform: translate3d(calc((var(--s, 0) - 2.3) * 150%), 0, 0); }

  .hub__odo { display: none; }
  .hub.is-pinned .hub__odo { display: flex; align-items: baseline; gap: 14px; position: absolute; z-index: 10; top: calc(var(--header-h) + 22px); left: var(--gutter); font: 600 clamp(56px, 7.2vw, 128px)/1 var(--f-display); letter-spacing: -.01em; color: #fff; }
  .odo { display: inline-flex; height: 1em; overflow: hidden; }
  .odo::before { content: '0'; }
  .odo__col { display: block; transform: translate3d(0, calc(var(--odo, 0) * -1em), 0); }
  .odo__col i { display: block; height: 1em; font-style: normal; }
  .odo__of { font-size: .26em; letter-spacing: .16em; color: rgba(255,255,255,.65); }
  .hub.is-pinned .world__idx b, .hub.is-pinned .world__idx span { display: none; }
  .hub.is-pinned .world__idx em { margin-left: 0; }
  .hub.is-pinned .hub__nav { display: grid; gap: 6px; position: absolute; z-index: 10; right: var(--gutter); top: 50%; transform: translateY(-50%); padding-right: 18px; text-align: right; }
  .hub__nav a { display: flex; justify-content: flex-end; gap: 12px; padding: 8px 0; font: 600 14px var(--f-display); letter-spacing: .16em; text-transform: uppercase; color: rgba(255,255,255,.55); transition: color .3s, transform .5s var(--ease); }
  .hub__nav a b { font-weight: 600; }
  .hub__nav a[aria-current] { color: #fff; transform: translateX(-8px); }
  .hub__nav a[aria-current] b { color: var(--red); }
  .hub__nav a:hover { color: #fff; }
  .hub__bar { position: absolute; right: 0; top: 4px; bottom: 4px; width: 1px; background: rgba(255,255,255,.3); }
  .hub__bar i { position: absolute; inset: 0; background: #fff; transform-origin: top; transform: scaleY(var(--p, 0)); }

  /* manifest */
  .manifest { display: grid; grid-template-columns: 1fr; gap: 60px; padding-block: clamp(90px, 14vw, 220px); background: var(--paper); color: var(--ink); }
  .manifest__text { display: grid; gap: 26px; align-content: start; }
  .manifest h2 { max-width: 14ch; }
  .manifest__stack { position: relative; min-height: 120vw; }
  .manifest__stack .frame { position: absolute; }
  .m1 { width: 56%; aspect-ratio: 3/4; left: 0; top: 0; }
  .m2 { width: 62%; aspect-ratio: 4/3; right: 0; top: 38%; }
  .m3 { width: 44%; aspect-ratio: 3/4; left: 8%; bottom: 0; }
  .manifest__stack :global([data-parallax]) { inset: -10% 0; height: 120%; }
  @media (min-width: 900px) {
    .manifest { grid-template-columns: .9fr 1.1fr; gap: 8vw; align-items: start; }
    .manifest__text { position: sticky; top: calc(var(--header-h) + 60px); }
    .manifest__stack { min-height: 78vw; }
    .m1 { width: 34%; }
    .m2 { width: 52%; top: 22%; }
    .m3 { width: 30%; left: 18%; }
  }

  /* feature */
  .feature { background: var(--paper); padding-bottom: 0; --e: clamp(0, (var(--p, 0) - .12) * 3.2, 1); }
  .feature__frame { position: relative; display: block; height: 100svh; min-height: 560px; overflow: hidden; color: #fff; clip-path: inset(calc((1 - var(--e)) * 12%) calc((1 - var(--e)) * 7%) 0 calc((1 - var(--e)) * 7%)); }
  :global(.rm) .feature__frame { clip-path: none; }
  .feature__frame :global(img) { transition: transform 2s var(--ease); }
  .feature__frame:hover :global(img) { transform: scale(1.03); }
  .feature__shade { position: absolute; inset: 0; background: linear-gradient(0deg, rgba(5,5,6,.85), transparent 55%); }
  .feature__copy { position: absolute; inset: auto 0 0; display: grid; gap: 14px; justify-items: start; padding-bottom: clamp(30px, 6vh, 70px); }
  .feature__meta { max-width: 52ch; color: rgba(255,255,255,.85); }
</style>
