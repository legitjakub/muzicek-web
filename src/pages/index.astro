---
import {VisualEditing} from '@sanity/astro/visual-editing'
import {sanity} from '../lib/sanity'
import '../styles/site.css'
import ArrowIcon from '../components/ArrowIcon.astro'

type Area = {title: string; slug: string; shortDescription: string}
const areas = await sanity.fetch<Area[]>(`*[_type == "businessArea"] | order(order asc) {
  title, "slug": slug.current, shortDescription
}`)

const areaImages: Record<string, string> = {
  auta: '/media/vehicle-audi-rs4-1.jpg',
  servis: '/media/service-cayman.jpg',
  detailing: '/media/ppf-work.jpg',
}
const areaLabels: Record<string, string> = {auta: 'Auta', servis: 'Servis', detailing: 'Detailing'}
const areaDescriptions: Record<string, string> = {
  auta: 'Prověření, dovoz, prodej a krytá přeprava.',
  servis: 'Pravidelná údržba, opravy, performance a péče o podvozek.',
  detailing: 'Ochrana, změna vzhledu, obnova a pravidelná péče.',
}
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Mužíček — dovoz a prodej vozů, servis a detailing v Jablonci nad Nisou." />
    <title>Mužíček — auta, servis a detailing</title>
  </head>
  <body class="portal-page">
    <a class="home-skip" href="#main-content">Přejít na obsah</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Mužíček — domů"><img src="/images/muzicek-mark.png" alt="" /></a>
      <p class="header-note">Jablonec nad Nisou<br />Po–Pá 8:00–17:00</p>
      <a class="header-contact" href="mailto:info@muzicek.com"><span>Napsat nám</span><ArrowIcon /></a>
    </header>

    <main id="main-content">
      <section class="portal-home" aria-labelledby="portal-title">
        <div class="backdrop" aria-hidden="true">
          {areas.map((area, index) => (
            <div class:list={['portal-bg', {'is-active': index === 0}]} data-slug={area.slug} style={`background-image: url('${areaImages[area.slug]}')`}></div>
          ))}
        </div>

        <h1 class="sr-only" id="portal-title">Mužíček — auta, servis a detailing</h1>

        <nav class="portal-list" aria-label="Oblasti Mužíček">
          {areas.map((area) => (
            <a class="portal" href={`/${area.slug}/`} data-portal={area.slug}>
              <span class="portal-title">{areaLabels[area.slug] || area.title}</span>
              <span class="portal-description">{areaDescriptions[area.slug] || area.shortDescription}</span>
              <span class="portal-arrow"><ArrowIcon direction="upRight" /></span>
            </a>
          ))}
        </nav>
      </section>
    </main>

    <script>
      const links = Array.from(document.querySelectorAll<HTMLElement>('[data-portal]'))
      const backgrounds = Array.from(document.querySelectorAll<HTMLElement>('.portal-bg'))
      let activeSlug = links[0]?.dataset.portal
      let filmTimer: number | undefined

      function showBackground(slug?: string) {
        if (!slug || slug === activeSlug) return
        activeSlug = slug
        backgrounds.forEach((background) => background.classList.toggle('is-active', background.dataset.slug === slug))
      }
      function startFilm() {
        window.clearInterval(filmTimer)
        filmTimer = window.setInterval(() => {
          const index = links.findIndex((link) => link.dataset.portal === activeSlug)
          showBackground(links[(index + 1) % links.length]?.dataset.portal)
        }, 5600)
      }
      links.forEach((link) => {
        link.addEventListener('pointerenter', () => { window.clearInterval(filmTimer); showBackground(link.dataset.portal) })
        link.addEventListener('focus', () => { window.clearInterval(filmTimer); showBackground(link.dataset.portal) })
        link.addEventListener('pointerleave', startFilm)
        link.addEventListener('blur', startFilm)
      })
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) startFilm()
    </script>
    <VisualEditing enabled={import.meta.env.DEV} />
  </body>
</html>

<style>
  .portal-page { background: #e8e5de; }
  .home-skip { position: fixed; z-index: 100; top: 10px; left: 10px; padding: 10px 14px; background: #fff; color: #111; font-size: 11px; font-weight: 800; transform: translateY(-160%); transition: transform .15s; }
  .home-skip:focus { transform: translateY(0); }
  .site-header { position: absolute; z-index: 20; inset: 0 0 auto; height: 96px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 clamp(20px, 3.5vw, 58px); border-bottom: 1px solid rgba(255,255,255,.34); color: #fff; }
  .brand { display: flex; align-items: center; }
  .brand img { width: 82px; height: 40px; object-fit: contain; filter: brightness(0) invert(1); }
  .header-note { margin: 0; text-align: center; font-size: 9px; font-weight: 700; line-height: 1.55; letter-spacing: .14em; text-transform: uppercase; }
  .header-contact { justify-self: end; display: flex; align-items: center; gap: 12px; font-size: 10px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase; }
  .header-contact :global(svg) { color: var(--red); }

  .portal-home { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: flex-end; padding: clamp(145px, 18vh, 210px) clamp(20px, 3.5vw, 58px) clamp(25px, 5vh, 56px); overflow: hidden; isolation: isolate; color: #fff; }
  .backdrop, .backdrop::after, .portal-bg { position: absolute; inset: 0; }
  .backdrop { z-index: -3; background: #111; }
  .backdrop::after { content: ''; background: linear-gradient(0deg, rgba(0,0,0,.87), rgba(0,0,0,.22) 67%, rgba(0,0,0,.28)), linear-gradient(90deg, rgba(0,0,0,.32), transparent 75%); }
  .portal-bg { opacity: 0; background-size: cover; background-position: center; transform: scale(1.035); transition: opacity 1.1s cubic-bezier(.25,.1,.25,1); }
  .portal-bg[data-slug='auta'] { background-position: center 58%; }
  .portal-bg[data-slug='servis'] { background-position: center 52%; }
  .portal-bg[data-slug='detailing'] { background-position: center 46%; }
  .portal-bg.is-active { opacity: 1; animation: camera-drift 11s cubic-bezier(.25,.1,.25,1) both; }
  @keyframes camera-drift { from { transform: scale(1.015); } to { transform: scale(1.065); } }

  .portal-list { width: 100%; max-width: 1420px; margin-left: auto; border-top: 1px solid rgba(255,255,255,.46); }
  .portal { position: relative; display: grid; grid-template-columns: minmax(250px,1fr) minmax(210px,.52fr) 48px; align-items: center; gap: clamp(16px,3vw,55px); min-height: clamp(126px,21vh,192px); border-bottom: 1px solid rgba(255,255,255,.38); outline: none; }
  .portal::before { content: ''; position: absolute; inset: 0 -18px; z-index: -1; background: #ece9e2; transform: scaleY(0); transform-origin: bottom; transition: transform .42s cubic-bezier(.76,0,.24,1); }
  .portal-title { font-family: 'Avenir Next Condensed','DIN Condensed','Helvetica Neue',sans-serif; font-size: clamp(58px,8vw,132px); font-weight: 800; letter-spacing: -.06em; line-height: .85; text-transform: uppercase; transition: transform .4s ease, color .25s ease; }
  .portal-description { max-width: 340px; color: rgba(255,255,255,.72); font-size: clamp(11px,1vw,15px); line-height: 1.55; transition: color .25s ease; }
  .portal-arrow { display: grid; place-items: center; width: 46px; height: 46px; border: 1px solid rgba(255,255,255,.46); transition: border-color .25s, color .25s, transform .35s; }
  .portal:hover::before, .portal:focus-visible::before { transform: scaleY(1); }
  .portal:hover .portal-title, .portal:focus-visible .portal-title { color: #0b0b0b; transform: translateX(7px); }
  .portal:hover .portal-description, .portal:focus-visible .portal-description { color: #424242; }
  .portal:hover .portal-arrow, .portal:focus-visible .portal-arrow { color: var(--red); border-color: var(--red); transform: rotate(45deg); }

  @media (max-width: 980px) {
    .site-header { grid-template-columns: 1fr 1fr; }
    .header-note { display: none; }
    .portal-home { padding-top: 140px; }
    .portal { grid-template-columns: minmax(220px,1fr) minmax(150px,.65fr) 40px; min-height: 125px; }
    .portal-title { font-size: clamp(52px,8.5vw,82px); }
  }
  @media (max-width: 600px) {
    .site-header { height: 76px; padding-inline: 18px; }
    .brand img { width: 66px; }
    .header-contact span { display: none; }
    .portal-home { padding: 115px 18px 24px; }
    .portal { grid-template-columns: 1fr 34px; gap: 13px; min-height: clamp(130px,21svh,168px); }
    .portal::before { inset: 0 -8px; }
    .portal-title { grid-column: 1; align-self: end; font-size: clamp(44px,12.5vw,68px); }
    .portal-description { grid-column: 1; grid-row: 2; align-self: start; font-size: 11px; line-height: 1.45; }
    .portal-arrow { grid-column: 2; grid-row: 1 / 3; align-self: center; width: 34px; height: 34px; }
  }
  @media (max-width: 360px) {
    .portal-title { font-size: 42px; }
    .portal { min-height: 125px; }
    .portal-description { font-size: 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .portal-bg.is-active { animation: none; }
    .portal-bg, .portal::before, .portal-title, .portal-description, .portal-arrow { transition: none; }
  }
</style>
