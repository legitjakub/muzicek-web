---
import {VisualEditing} from '@sanity/astro/visual-editing'
import {sanity} from '../lib/sanity'
import '../styles/site.css'
import ArrowIcon from '../components/ArrowIcon.astro'

type Area = {title: string; slug: string; shortDescription: string}
const areas = await sanity.fetch<Area[]>(`*[_type == "businessArea"] | order(order asc) {
  title, "slug": slug.current, shortDescription
}`)

const areaImages: Record<string, string> = {
  auta: '/media/vehicle-audi-rs4-1.jpg',
  servis: '/media/service-cayman.jpg',
  detailing: '/media/ppf-work.jpg',
}
const areaLabels: Record<string, string> = {auta: 'Auta', servis: 'Servis', detailing: 'Detailing'}
const areaDescriptions: Record<string, string> = {
  auta: 'Prověření, dovoz, prodej a krytá přeprava.',
  servis: 'Pravidelná údržba, opravy, performance a péče o podvozek.',
  detailing: 'Ochrana, změna vzhledu, obnova a pravidelná péče.',
}
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Mužíček — dovoz a prodej vozů, servis a detailing v Jablonci nad Nisou." />
    <title>Mužíček — auta, servis a detailing</title>
  </head>
  <body class="portal-page">
    <a class="home-skip" href="#main-content">Přejít na obsah</a>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Mužíček — domů"><img src="/images/muzicek-mark.png" alt="" /></a>
      <p class="header-note">Jablonec nad Nisou<br />Po–Pá 8:00–17:00</p>
      <a class="header-contact" href="mailto:info@muzicek.com"><span>Napsat nám</span><ArrowIcon /></a>
    </header>

    <main id="main-content">
      <section class="portal-home" aria-labelledby="portal-title">
        <div class="backdrop" aria-hidden="true">
          {areas.map((area, index) => (
            <div class:list={['portal-bg', {'is-active': index === 0}]} data-slug={area.slug} style={`background-image: url('${areaImages[area.slug]}')`}></div>
          ))}
        </div>

        <div class="hero-intro">
          <p class="eyebrow">Mužíček, od roku 2014</p>
          <h1 id="portal-title">Výběr vozu, servis<br />a péče o povrch.</h1>
          <p>Vyberte oblast, kterou právě potřebujete řešit.</p>
        </div>

        <nav class="portal-list" aria-label="Oblasti Mužíček">
          {areas.map((area) => (
            <a class="portal" href={`/${area.slug}/`} data-portal={area.slug}>
              <span class="portal-title">{areaLabels[area.slug] || area.title}</span>
              <span class="portal-description">{areaDescriptions[area.slug] || area.shortDescription}</span>
              <span class="portal-arrow"><ArrowIcon direction="upRight" /></span>
            </a>
          ))}
        </nav>
      </section>
    </main>

    <script>
      const links = Array.from(document.querySelectorAll<HTMLElement>('[data-portal]'))
      const backgrounds = Array.from(document.querySelectorAll<HTMLElement>('.portal-bg'))
      let activeSlug = links[0]?.dataset.portal
      let filmTimer: number | undefined

      function showBackground(slug?: string) {
        if (!slug || slug === activeSlug) return
        activeSlug = slug
        backgrounds.forEach((background) => background.classList.toggle('is-active', background.dataset.slug === slug))
      }
      function startFilm() {
        window.clearInterval(filmTimer)
        filmTimer = window.setInterval(() => {
          const index = links.findIndex((link) => link.dataset.portal === activeSlug)
          showBackground(links[(index + 1) % links.length]?.dataset.portal)
        }, 5600)
      }
      links.forEach((link) => {
        link.addEventListener('pointerenter', () => { window.clearInterval(filmTimer); showBackground(link.dataset.portal) })
        link.addEventListener('focus', () => { window.clearInterval(filmTimer); showBackground(link.dataset.portal) })
        link.addEventListener('pointerleave', startFilm)
        link.addEventListener('blur', startFilm)
      })
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) startFilm()
    </script>
    <VisualEditing enabled={import.meta.env.DEV} />
  </body>
</html>

<style>
  .portal-page{background:#e8e5de}.home-skip{position:fixed;z-index:100;top:10px;left:10px;padding:10px 14px;background:#fff;color:#111;font-size:11px;font-weight:800;transform:translateY(-160%);transition:transform .15s}.home-skip:focus{transform:translateY(0)}.site-header{position:absolute;z-index:20;inset:0 0 auto;height:96px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;padding:0 clamp(20px,3.5vw,58px);border-bottom:1px solid rgba(255,255,255,.34);color:#fff}.brand{display:flex;align-items:center}.brand img{width:82px;height:40px;object-fit:contain;filter:brightness(0) invert(1)}.header-note{margin:0;text-align:center;font-size:9px;font-weight:700;line-height:1.55;letter-spacing:.14em;text-transform:uppercase}.header-contact{justify-self:end;display:flex;align-items:center;gap:12px;font-size:10px;font-weight:800;letter-spacing:.11em;text-transform:uppercase}.header-contact :global(svg){color:var(--red)}
  .portal-home{position:relative;height:100svh;min-height:680px;display:grid;grid-template-columns:minmax(320px,.82fr) minmax(560px,1.18fr);align-items:end;gap:clamp(54px,7vw,120px);padding:132px clamp(20px,3.5vw,58px) 48px;overflow:hidden;isolation:isolate;color:#fff}.backdrop,.backdrop::after,.portal-bg{position:absolute;inset:0}.backdrop{z-index:-3;background:#111}.portal-bg{opacity:0;background-size:cover;background-position:center;transform:scale(1.015);transition:opacity .75s ease}.portal-bg[data-slug='auta']{background-position:center 58%}.portal-bg[data-slug='servis']{background-position:center 52%}.portal-bg[data-slug='detailing']{background-position:center 46%}.portal-bg.is-active{opacity:1;animation:camera-drift 11s cubic-bezier(.25,.1,.25,1) both}.backdrop::after{content:'';background:linear-gradient(90deg,rgba(0,0,0,.84) 0%,rgba(0,0,0,.35) 58%,rgba(0,0,0,.66) 100%),linear-gradient(0deg,rgba(0,0,0,.82),transparent 58%,rgba(0,0,0,.25))}@keyframes camera-drift{from{transform:scale(1.015)}to{transform:scale(1.065)}}
  .hero-intro{align-self:center;padding-top:82px}.eyebrow{margin:0 0 20px;font-size:9px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.hero-intro h1{max-width:650px;margin:0;font-family:'Iowan Old Style','Baskerville',Georgia,serif;font-size:clamp(44px,4.7vw,72px);font-weight:400;line-height:.94;letter-spacing:-.045em;text-wrap:balance}.hero-intro>p:last-child{max-width:360px;margin:24px 0 0;color:rgba(255,255,255,.72);font-size:13px;line-height:1.6}
  .portal-list{align-self:end;border-top:1px solid rgba(255,255,255,.38)}.portal{position:relative;display:grid;grid-template-columns:minmax(220px,.9fr) minmax(190px,.72fr) 42px;align-items:center;gap:clamp(20px,2.5vw,40px);min-height:clamp(112px,15vh,150px);border-bottom:1px solid rgba(255,255,255,.38);outline:none}.portal::before{content:'';position:absolute;inset:0 -18px;z-index:-1;background:#ece9e2;transform:scaleY(0);transform-origin:bottom;transition:transform .42s cubic-bezier(.76,0,.24,1)}.portal-title{font-family:'Avenir Next Condensed','DIN Condensed','Helvetica Neue',sans-serif;font-size:clamp(42px,4.8vw,76px);font-weight:800;letter-spacing:-.045em;line-height:.85;text-transform:uppercase;transition:transform .4s ease,color .25s ease}.portal-description{max-width:260px;color:rgba(255,255,255,.72);font-size:12px;line-height:1.55;transition:color .25s ease}.portal-arrow{display:grid;place-items:center;width:40px;height:40px;border:1px solid rgba(255,255,255,.46);transition:border-color .25s,color .25s,transform .35s}.portal:hover::before,.portal:focus-visible::before{transform:scaleY(1)}.portal:hover .portal-title,.portal:focus-visible .portal-title{color:#0b0b0b;transform:translateX(7px)}.portal:hover .portal-description,.portal:focus-visible .portal-description{color:#424242}.portal:hover .portal-arrow,.portal:focus-visible .portal-arrow{color:var(--red);border-color:var(--red);transform:rotate(45deg)}
  @media(max-width:980px){.site-header{grid-template-columns:1fr 1fr}.header-note{display:none}.portal-home{height:auto;min-height:100svh;grid-template-columns:1fr;align-content:end;gap:30px;padding-top:125px}.hero-intro{align-self:auto;padding-top:0}.hero-intro h1{font-size:clamp(42px,7.4vw,66px)}.portal{min-height:96px}}
  @media(max-width:600px){.site-header{height:76px;padding-inline:18px}.brand img{width:66px}.header-contact span{display:none}.portal-home{padding:105px 18px 22px;gap:22px}.hero-intro h1{font-size:38px}.hero-intro>p:last-child{margin-top:14px;font-size:12px}.eyebrow{margin-bottom:14px}.portal{grid-template-columns:1fr 34px;min-height:78px;gap:12px}.portal-description{display:none}.portal-title{font-size:clamp(36px,11vw,52px)}.portal-arrow{width:32px;height:32px}}
</style>
